#!/bin/sh /etc/rc.common
START=95
STOP=10
USE_PROCD=1
start_service() {
 [ "$(uci -q get ipv6_cleaner.main.enabled)" = 1 ] || return 0
 procd_open_instance
 procd_set_param command /usr/sbin/ipv6-cleaner daemon
 procd_set_param respawn
 procd_set_param stdout 1
 procd_set_param stderr 1
 procd_close_instance
}
reload_service() {
 stop
 start
}
service_triggers() {
 procd_add_reload_trigger ipv6_cleaner
}
