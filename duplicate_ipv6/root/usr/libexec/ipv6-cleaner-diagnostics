#!/bin/sh
# Count public WAN addresses and restart only the owning DHCPv6 interface.
RUNDIR=/var/run/ipv6-cleaner
umask 077
mkdir -p "$RUNDIR" || exit 1
exec 9>"$RUNDIR/diagnostics.lock"
flock -n 9 || { echo '{"error":"Diagnostics already running"}'; exit 1; }
work="$(mktemp -d "$RUNDIR/diagnostic.XXXXXX")" || exit 1
echo $$ > "$RUNDIR/diagnostic.pid"
trap 'rm -rf "$work"; rm -f "$RUNDIR/diagnostic.pid"' EXIT
trap 'exit 1' INT TERM
ip -o -6 addr show scope global > "$work/raw" || exit 1
ip -6 route show table all > "$work/routes" || exit 1
awk '$1=="default" { for(i=1;i<NF;i++) if($i=="dev") print $(i+1) }' "$work/routes" > "$work/wan"
awk '
 FILENAME==ARGV[1] {wan[$1]=1; next}
 $3=="inet6" && $5=="scope" && $6=="global" {
  dev=$2; sub(/@.*/,"",dev); addr=tolower($4)
  if(!wan[dev] || dev !~ /^[a-zA-Z0-9_.:-]+$/) next
  if(addr !~ /^[23][0-9a-f][0-9a-f][0-9a-f]:[0-9a-f:]+\/[0-9]+$/) next
  for(i=7;i<=NF;i++) if($i=="tentative" || $i=="dadfailed") next
  print dev,addr
 }' "$work/wan" "$work/raw" | sort -u > "$work/list"
awk '
 {count[$1]++; device[NR]=$1; address[NR]=$2}
 END {
  for (i=1;i<=NR;i++)
   if (count[device[i]]>=2) print device[i],address[i]
 }' "$work/list" > "$work/multiple"
mv "$work/multiple" "$RUNDIR/public-addresses.tsv"
date +%s > "$RUNDIR/diagnostics_time"

restart_device() {
 local device="$1" address="$2" peer result
 grep -Fqx -- "$device $address" "$RUNDIR/public-addresses.tsv" || return 1
 peer="$(awk -v device="$device" -v address="$address" '$1==device && $2!=address {print $2; exit}' "$RUNDIR/public-addresses.tsv")"
 [ -n "$peer" ] || return 1
 /usr/libexec/ipv6-cleaner-restart "$device" "$address" "$peer"
 result=$?
 [ "$result" -ne 1 ] || logger -t ipv6-cleaner "IPv6-only restart unavailable for $device with multiple public addresses"
 return "$result"
}
case "$1" in
 remove|restart)
  if [ "$4" = confirmed ] && restart_device "$2" "$3"; then
   echo '{"restarted":true}'
  else
   echo '{"error":"Two public addresses on one DHCPv6 interface and confirmation are required. Check the restart cooldown."}'
  fi;;
 auto)
  if [ "$(uci -q get ipv6_cleaner.main.enabled)" = 1 ] &&
     [ "$(uci -q get ipv6_cleaner.main.stale_detection)" = 1 ] &&
     [ "$(uci -q get ipv6_cleaner.main.mode)" = remove ]; then
   awk '!seen[$1]++' "$RUNDIR/public-addresses.tsv" > "$work/devices"
   while read -r device address; do
    restart_device "$device" "$address" || :
   done < "$work/devices"
  fi
  echo '{"complete":true}';;
 *) echo '{"complete":true}';;
esac
