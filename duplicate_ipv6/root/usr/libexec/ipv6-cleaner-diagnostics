#!/bin/sh
# Repeated interface-bound evidence permits automatic cleanup only in Remove mode.
RUNDIR=/var/run/ipv6-cleaner
umask 077
mkdir -p "$RUNDIR" || exit 1
exec 9>"$RUNDIR/diagnostics.lock"
flock -n 9 || { echo '{"error":"Diagnostics already running"}'; exit 1; }
work="$(mktemp -d "$RUNDIR/diagnostic.XXXXXX")" || exit 1
echo $$ > "$RUNDIR/diagnostic.pid"
trap 'rm -rf "$work"; rm -f "$RUNDIR/diagnostic.pid"' EXIT
trap 'exit 1' INT TERM
snapshot() {
 ip -o -6 addr show scope global > "$work/raw" 2>/dev/null || return 1
 ip -6 route show table all > "$work/routes" 2>/dev/null || return 1
 awk '$1 == "default" { for(i=1;i<NF;i++) if($i=="dev") print $(i+1) }' "$work/routes" | sort -u > "$work/wan"
 awk '
 NR==FNR {wan[$1]=1; next}
 $3=="inet6" && $5=="scope" && $6=="global" {
  dev=$2; sub(/@.*/,"",dev); addr=tolower($4)
  if(!wan[dev] || dev !~ /^[a-zA-Z0-9_.:-]+$/) next
  if(addr !~ /^[23][0-9a-f][0-9a-f][0-9a-f]:[0-9a-f:]+\/64$/) next
  unsafe=0; valid=0; preferred=0
  for(i=7;i<=NF;i++) {
   if($i=="deprecated" || $i=="tentative" || $i=="dadfailed") unsafe=1
   if($i=="valid_lft" && $(i+1)=="forever") valid=1
   if($i=="preferred_lft" && $(i+1)=="forever") preferred=1
  }
  if(!unsafe && valid && preferred) print dev,addr
 }' "$work/wan" "$work/raw" | sort -u > "$work/list"
}
modern=0
version="$(curl --version 2>/dev/null | awk 'NR==1 { print $2 }')"
major="${version%%.*}"; tail="${version#*.}"; minor="${tail%%.*}"
case "$major:$minor" in *[!0-9:]*|:|*:) ;; *)
 if [ "$major" -gt 8 ] || { [ "$major" -eq 8 ] && [ "$minor" -ge 9 ]; }; then modern=1; fi;; esac
route_device() {
 ip -6 route get "$1" from "$2" 2>/dev/null | awk 'NR==1 { for(i=1;i<NF;i++) if($i=="dev") {print $(i+1);exit} }'
}
probe() {
 # Result: success count (0..2), or -1 if source/device binding is uncertain.
 probe_dev="$1"; probe_ip="${2%%/*}"; hits=0
 command -v curl >/dev/null 2>&1 || { echo -1; return; }
 for target in 2606:4700:4700::1111 2001:4860:4860::8888; do
  if [ "$modern" = 1 ]; then binding="ifhost!$probe_dev!$probe_ip"
  else
   [ "$(route_device "$target" "$probe_ip")" = "$probe_dev" ] || { echo -1; return; }
   binding="$probe_ip"
  fi
  # remote_ip is populated only after TCP connects; certificate/HTTP status
  # does not affect this connectivity check. No response body is downloaded.
  remote="$(curl --noproxy '*' -6 --interface "$binding" --connect-timeout 2 --max-time 3 -s -I -o /dev/null -w '%{remote_ip}' "https://[$target]/")"
  result=$?
  [ "$result" -ne 45 ] || { echo -1; return; }
  if [ "$modern" != 1 ]; then
   [ "$(route_device "$target" "$probe_ip")" = "$probe_dev" ] || { echo -1; return; }
  fi
  [ -z "$remote" ] || hits=$((hits+1))
 done
 echo "$hits"
}
snapshot || { echo '{"error":"Unable to read WAN addresses"}'; exit 1; }
now="$(date +%s)"
restart_address() {
 dev="$1"; addr="$2"
 [ "$3" = confirmed ] || { echo '{"error":"Explicit confirmation required"}'; return 1; }
 # Accept only a recent, sustained finding from this device's exact address.
 match="$(awk -v d="$dev" -v a="$addr" '$1==d && $2==a && $9=="suspected_stale" { print $0 }' "$RUNDIR/diagnostics.tsv" 2>/dev/null)"
 [ -n "$match" ] || { echo '{"error":"Address is not a confirmed diagnostic candidate"}'; return 1; }
 checked="$(echo "$match" | awk '{print $8}')"
 [ "$((now-checked))" -le 300 ] || { echo '{"error":"Evidence expired; run diagnostics again"}'; return 1; }
 grep -Fqx "$dev $addr" "$work/list" || { echo '{"error":"Address changed; restart cancelled"}'; return 1; }
 [ "$(probe "$dev" "$addr")" = 0 ] || { echo '{"error":"Address responded or could not be checked; restart cancelled"}'; return 1; }
 alternative=0
 while read -r other_dev other_addr; do
  [ "$other_dev" = "$dev" ] && [ "$other_addr" != "$addr" ] || continue
  if [ "$(probe "$other_dev" "$other_addr")" = 2 ]; then alternative=1; break; fi
 done < "$work/list"
 [ "$alternative" = 1 ] || { echo '{"error":"No verified working alternative on this WAN; restart cancelled"}'; return 1; }
 # Another immediate snapshot prevents restarting for a renewed/replaced address.
 snapshot && grep -Fqx "$dev $addr" "$work/list" || { echo '{"error":"Address changed; restart cancelled"}'; return 1; }
 if /usr/libexec/ipv6-cleaner-restart "$dev" "$addr"; then
  awk -v d="$dev" '$1!=d' "$RUNDIR/diagnostics.tsv" > "$work/new"
  mv "$work/new" "$RUNDIR/diagnostics.tsv"
  echo '{"restarted":true}'
 else echo '{"error":"IPv6-only restart could not be completed or is in cooldown"}'; return 1; fi
 return 0
}
if [ "$1" = remove ] || [ "$1" = restart ]; then
 restart_address "$2" "$3" "$4"
 exit $?
fi
# Bound diagnostic work: only shared WAN devices with 2+ qualifying addresses.
awk 'NR==FNR {n[$1]++;next} n[$1]>1 {print}' "$work/list" "$work/list" | head -8 > "$work/check"
: > "$work/results"
while read -r dev addr; do
 hits="$(probe "$dev" "$addr")"
 echo "$dev $addr $hits" >> "$work/results"
done < "$work/check"
cp "$work/results" "$work/positive"
# Atomic history; absence or a changed address resets its previous failure streak.
old="$RUNDIR/diagnostics.tsv"
[ -f "$old" ] || : > "$old"
awk -v now="$now" '
FILENAME==ARGV[1] { key=$1 " " $2; old_fail[key]=$5; old_firstfail[key]=$6; old_first[key]=$7; old_checked[key]=$8; next }
FILENAME==ARGV[2] {if($3==2) good[$1]=1; next}
{
 key=$1 " " $2; first=old_first[key]+0; if(!first) first=now
 failures=0; start=0; verdict="unverified"
 if($3>0) verdict="reachable"
 else if($3==0 && good[$1]) {
  if(now-old_checked[key]>90) {old_fail[key]=0; old_firstfail[key]=0}
  failures=old_fail[key]+1; start=old_firstfail[key]+0; if(!start) start=now
  verdict="checking"
  if(failures>=3 && now-start>=30) verdict="suspected_stale"
 }
 print $1,$2,$3,2,failures,start,first,now,verdict
}' "$old" "$work/positive" "$work/results" > "$work/new"
mv "$work/new" "$RUNDIR/diagnostics.tsv"
echo "$now" > "$RUNDIR/diagnostics_time"
# An independent fast watcher calls auto; direct inspect/run stays diagnostic-only.
# Never remove in monitor mode, on older curl with uncertain device binding,
# or when scheduling/diagnostics has been disabled during a check.
if [ "$1" = auto ] && [ "$modern" = 1 ] &&
 [ "$(uci -q get ipv6_cleaner.main.enabled)" = 1 ] &&
 [ "$(uci -q get ipv6_cleaner.main.stale_detection)" = 1 ] &&
 [ "$(uci -q get ipv6_cleaner.main.mode)" = remove ]; then
 cp "$RUNDIR/diagnostics.tsv" "$work/auto"
 while read -r d a hits targets failures first_failure first_seen checked verdict; do
  [ "$verdict" = suspected_stale ] || continue
  restart_address "$d" "$a" confirmed >/dev/null || logger -t ipv6-cleaner "Stale restart cancelled after recheck for $a on $d"
 done < "$work/auto"
fi
echo '{"complete":true}'
