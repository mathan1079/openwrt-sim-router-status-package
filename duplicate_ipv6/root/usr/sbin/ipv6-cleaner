#!/bin/sh
. /usr/share/libubox/jshn.sh
RUNDIR=/var/run/ipv6-cleaner
umask 077
mkdir -p "$RUNDIR" || exit 1

settings() {
 enabled="$(uci -q get ipv6_cleaner.main.enabled)"
 mode="$(uci -q get ipv6_cleaner.main.mode)"
 interval="$(uci -q get ipv6_cleaner.main.interval)"
 case "$interval" in ''|*[!0-9]*) interval=120;; esac
 [ "${#interval}" -le 5 ] || interval=120
 [ "$interval" -ge 60 ] && [ "$interval" -le 86400 ] || interval=120
 [ "$mode" = remove ] || mode=monitor
}
candidates() {
 ip -o -6 addr show scope global > "$1.raw" 2>/dev/null || return 1
 /usr/libexec/ipv6-cleaner-candidates < "$1.raw" > "$1"
}
run_once() {
 # Kernel releases flock automatically if the process dies.
 exec 9>"$RUNDIR/lock"
 flock -n 9 || { echo '{"error":"A scan is already running"}'; return 1; }
 settings
 work="$(mktemp -d "$RUNDIR/scan.XXXXXX")" || return 1
 trap 'rm -rf "$work"' EXIT
 candidates "$work/list" || { echo '{"error":"Unable to read IPv6 addresses"}'; return 1; }
 found=0; removed=0; failed=0
 json_init
 json_add_array addresses
 while read -r dev addr; do
  [ -n "$addr" ] || continue
  found=$((found + 1)); result=monitored
  if [ "$mode" = remove ]; then
   # Re-read immediately before deleting: the address may have been renewed.
   if ip -o -6 addr show dev "$dev" scope global > "$work/current.raw" 2>/dev/null; then
    /usr/libexec/ipv6-cleaner-candidates < "$work/current.raw" > "$work/current"
    if grep -Fqx "$dev $addr" "$work/current"; then
     if ip -6 addr del "$addr" dev "$dev"; then
      removed=$((removed + 1)); result=removed
      logger -t ipv6-cleaner "Removed deprecated $addr from $dev"
     else
      failed=$((failed + 1)); result=failed
     fi
    else
     result=changed
    fi
   else
    failed=$((failed + 1)); result=failed
   fi
  fi
  json_add_object ''
  json_add_string device "$dev"
  json_add_string address "$addr"
  json_add_string result "$result"
  json_close_object
 done < "$work/list"
 json_close_array
 now="$(date +%s)"
 last=0
 if [ -f "$RUNDIR/last_clear" ]; then read -r last < "$RUNDIR/last_clear"; fi
 if [ "$removed" -gt 0 ]; then last="$now"; echo "$last" > "$RUNDIR/last_clear"; fi
 json_add_int last_scan "$now"
 json_add_int last_clear "$last"
 json_add_int found "$found"
 json_add_int removed "$removed"
 json_add_int failed "$failed"
 json_add_string scan_mode "$mode"
 json_dump > "$work/state"
 mv "$work/state" "$RUNDIR/state.json"
 cat "$RUNDIR/state.json"
 [ "$failed" -eq 0 ]
}
status() {
 settings
 json_init
 if [ -s "$RUNDIR/state.json" ]; then json_load "$(cat "$RUNDIR/state.json")"; fi
 json_add_boolean enabled "$([ "$enabled" = 1 ] && echo 1 || echo 0)"
 json_add_string mode "$mode"
 json_add_int interval "$interval"
 next=0; running=0
 if [ -f "$RUNDIR/daemon.pid" ]; then
  read -r pid < "$RUNDIR/daemon.pid"
  case "$pid" in ''|*[!0-9]*) ;; *) kill -0 "$pid" 2>/dev/null && running=1;; esac
 fi
 if [ "$enabled" = 1 ] && [ "$running" = 1 ] && [ -f "$RUNDIR/next" ]; then read -r next < "$RUNDIR/next"; fi
 json_add_boolean running "$running"
 json_add_int next_scan "$next"
 json_dump
}
daemon() {
 echo $$ > "$RUNDIR/daemon.pid"
 trap 'rm -f "$RUNDIR/next" "$RUNDIR/daemon.pid"; exit 0' TERM INT EXIT
 while :; do
  settings
  [ "$enabled" = 1 ] || exit 0
  next=$(($(date +%s) + interval))
  echo "$next" > "$RUNDIR/next"
  while [ "$(date +%s)" -lt "$next" ]; do sleep 5 & wait $!; done
  "$0" run >/dev/null
 done
}
case "$1" in
 status) status;;
 run) run_once;;
 daemon) daemon;;
 *) echo 'Usage: ipv6-cleaner {status|run|daemon}' >&2; exit 2;;
esac
