config profile 'sim1'
	option name 'SIM 1'
	option apn_auto '0'
	option pdp_type 'IPV4V6'
	option auth_enabled '0'
	option auth_type '3'
	option network_mode 'AUTO'
	option band_auto '1'

config profile 'sim2'
	option name 'SIM 2'
	option apn_auto '0'
	option pdp_type 'IPV4V6'
	option auth_enabled '0'
	option auth_type '3'
	option network_mode 'AUTO'
	option band_auto '1'

config automation 'automation'
	option enabled '0'
	option default_sim 'sim1'
	option failure_seconds '20'
	option recover_before_failover '0'
	option disconnect_limit '3'
	option disconnect_window_minutes '10'
	option cooldown_minutes '30'
	option max_switches_per_day '4'

