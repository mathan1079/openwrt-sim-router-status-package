#!/bin/sh /etc/rc.common

START=99
STOP=10
USE_PROCD=1

start_service() {
	[ "$(uci -q get simmanager.automation.enabled)" = "1" ] || return 0
	if [ "$(uci -q get cellular.cellular.hw_asw)" = "1" ]; then
		/usr/sbin/simmanager-auto vendor-conflict
		return 0
	fi
	procd_open_instance
	procd_set_param command /usr/sbin/simmanager-auto run
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param term_timeout 10
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger "simmanager" "cellular"
}

reload_service() {
	stop
	start
}
