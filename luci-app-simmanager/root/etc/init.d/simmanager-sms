#!/bin/sh /etc/rc.common

START=98
STOP=11
USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /usr/sbin/simmanager-sms-daemon
	procd_set_param respawn 5 10 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param term_timeout 10
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger "cellular"
}
