#!/bin/sh

# Activation and rollback wrapper for the vendor cellular service.
# This script never writes firmware, bootloader, kernel or vendor script files.

status_file=/tmp/simmanager-activation.json
status_new=/tmp/simmanager-activation.json.new
lock_dir=/tmp/simmanager-control.lock
backup_root=/etc/simmanager/backups
latest_file="$backup_root/latest"

write_status() {
	state="$1"
	message="$2"
	target="${3:-}"
	backup="${4:-}"
	rollback_available=0
	[ -n "$backup" ] && [ -f "$backup/cellular" ] && rollback_available=1

	. /usr/share/libubox/jshn.sh
	json_init
	json_add_string state "$state"
	json_add_string message "$message"
	json_add_string target "$target"
	json_add_string backup "$backup"
	json_add_string rollback_available "$rollback_available"
	json_add_string updated_at "$(date +%s)"
	json_dump > "$status_new" && mv -f "$status_new" "$status_file"
	json_cleanup
}

show_status() {
	if [ -f "$status_file" ]; then
		cat "$status_file"
	else
		printf '{"state":"idle","message":"No activation has been started.","rollback_available":"0"}\n'
	fi
}

release_lock() {
	rmdir "$lock_dir" 2>/dev/null
}

acquire_lock() {
	if ! mkdir "$lock_dir" 2>/dev/null; then
		write_status failed "Another activation or rollback operation is already running." "${1:-}" "${2:-}"
		return 1
	fi
	trap release_lock EXIT HUP INT TERM
}

profile_value() {
	uci -q get "simmanager.$1.$2"
}

validate_printable() {
	value="$1"
	max_length="$2"
	[ "${#value}" -le "$max_length" ] || return 1
	[ -z "$value" ] || ! printf '%s' "$value" | LC_ALL=C grep -q '[^ -~]'
}

load_profile() {
	target="$1"
	[ "$target" = sim1 ] || [ "$target" = sim2 ] || return 1
	[ "$(uci -q get "simmanager.$target")" = profile ] || return 1

	apn_auto=$(profile_value "$target" apn_auto); apn_auto=${apn_auto:-0}
	apn=$(profile_value "$target" apn); apn=${apn:-}
	pdp=$(profile_value "$target" pdp_type); pdp=${pdp:-IPV4V6}
	pin=$(profile_value "$target" pin); pin=${pin:-}
	auth_enabled=$(profile_value "$target" auth_enabled); auth_enabled=${auth_enabled:-0}
	username=$(profile_value "$target" username); username=${username:-}
	password=$(profile_value "$target" password); password=${password:-}
	auth_type=$(profile_value "$target" auth_type); auth_type=${auth_type:-3}
	network_mode=$(profile_value "$target" network_mode); network_mode=${network_mode:-AUTO}
	band_auto=$(profile_value "$target" band_auto); band_auto=${band_auto:-1}

	case "$apn_auto" in 0|1) ;; *) return 1 ;; esac
	[ "$apn_auto" = 1 ] || [ -n "$apn" ] || return 1
	case "$apn" in *[!A-Za-z0-9._-]*) return 1 ;; esac
	[ "${#apn}" -le 100 ] || return 1
	case "$pdp" in IP|IPV6|IPV4V6) ;; *) return 1 ;; esac
	case "$pin" in ''|*[!0-9]*) [ -z "$pin" ] || return 1 ;; esac
	[ -z "$pin" ] || { [ "${#pin}" -ge 4 ] && [ "${#pin}" -le 8 ]; } || return 1
	case "$auth_enabled" in 0|1) ;; *) return 1 ;; esac
	case "$auth_type" in 0|1|2|3) ;; *) return 1 ;; esac
	case "$network_mode" in AUTO|LTE|NR5G:LTE|NR5G) ;; *) return 1 ;; esac
	[ "$band_auto" = 1 ] || return 1
	validate_printable "$username" 128 || return 1
	validate_printable "$password" 128 || return 1
	return 0
}

create_backup() {
	target="$1"
	stamp=$(date +%Y%m%d-%H%M%S)
	backup="$backup_root/$stamp-$$"
	mkdir -p "$backup" || return 1
	cp -p /etc/config/cellular "$backup/cellular" || return 1
	uci export cellular > "$backup/cellular.uci" || return 1
	sha256sum "$backup/cellular" | awk '{print $1}' > "$backup/cellular.sha256" || return 1
	old_sim=$(uci -q get cellular.cellular.hw_sim); old_sim=${old_sim:-unknown}
	{
		printf 'active_sim=%s\n' "$old_sim"
		printf 'target_sim=%s\n' "$target"
		printf 'created_at=%s\n' "$(date +%s)"
	} > "$backup/metadata"
	printf '%s\n' "$backup" > "$latest_file"
	printf '%s\n' "$backup"
}

set_cellular_option() {
	uci set "cellular.cellular.$1=$2"
}

apply_profile_config() {
	set_cellular_option m_apn_auto "$apn_auto" || return 1
	set_cellular_option m_apn "$apn" || return 1
	set_cellular_option m_pdp "$pdp" || return 1
	set_cellular_option m_context "$auth_enabled" || return 1
	set_cellular_option m_username "$username" || return 1
	set_cellular_option m_password "$password" || return 1
	set_cellular_option m_auth "$auth_type" || return 1
	set_cellular_option m_netmode "$network_mode" || return 1
	set_cellular_option m_band_auto 1 || return 1
	if [ -n "$pin" ]; then
		set_cellular_option m_pin "$pin" || return 1
	else
		uci -q delete cellular.cellular.m_pin
	fi
	uci commit cellular || return 1
	sync
}

wait_for_sim_ready() {
	query_port=/dev/ttyUSB3
	[ -c "$query_port" ] || query_port=$(uci -q get cellular.cellular.atdev)
	count=0
	while [ "$count" -lt 30 ]; do
		at-cmd "$query_port" 'AT+CPIN?' 2>/dev/null | tr -d '\r' | grep -q '+CPIN: READY' && return 0
		count=$((count + 1))
		sleep 2
	done
	return 1
}

wait_for_registration() {
	query_port=/dev/ttyUSB3
	[ -c "$query_port" ] || query_port=$(uci -q get cellular.cellular.atdev)
	count=0
	while [ "$count" -lt 45 ]; do
		registration=$(at-cmd "$query_port" 'AT+CEREG?' 2>/dev/null | tr -d '\r' | grep '+CEREG:' | tail -n 1)
		case "$registration" in *,1|*,1,*|*,5|*,5,*) return 0 ;; esac
		count=$((count + 1))
		sleep 2
	done
	return 1
}

vendor_switch() {
	target="$1"
	. /lib/functions/cellular.sh
	cellular_sw "$target" 1
}

restore_backup() {
	backup="$1"
	case "$backup" in "$backup_root"/*) ;; *) return 1 ;; esac
	[ -f "$backup/cellular" ] || return 1
	[ -f "$backup/cellular.sha256" ] || return 1
	expected_hash=$(cat "$backup/cellular.sha256")
	actual_hash=$(sha256sum "$backup/cellular" | awk '{print $1}')
	[ -n "$expected_hash" ] && [ "$expected_hash" = "$actual_hash" ] || return 1
	old_sim=$(sed -n 's/^active_sim=//p' "$backup/metadata" | head -n 1)
	[ "$old_sim" = sim1 ] || [ "$old_sim" = sim2 ] || return 1
	physical_sim=$(uci -q get cellular.cellular.hw_sim)
	cp -p "$backup/cellular" /etc/config/cellular || return 1
	sync
	if [ "$physical_sim" != "$old_sim" ]; then
		vendor_switch "$old_sim" || return 1
		wait_for_sim_ready || return 1
	fi
	/etc/init.d/cellular reload || return 1
	return 0
}

activate_profile() {
	target="$1"
	acquire_lock "$target" "" || return 1
	write_status validating "Validating $target profile. No changes have been made yet." "$target" ""
	if ! load_profile "$target"; then
		write_status failed "Profile validation failed. Manual APN profiles require an APN and automatic band selection." "$target" ""
		return 1
	fi

	mkdir -p "$backup_root" || {
		write_status failed "Could not create the persistent backup directory. No changes were made." "$target" ""
		return 1
	}
	write_status backing_up "Backing up the complete cellular configuration before making changes." "$target" ""
	backup=$(create_backup "$target") || {
		write_status failed "Backup failed. Activation was cancelled before any configuration change." "$target" ""
		return 1
	}

	old_sim=$(sed -n 's/^active_sim=//p' "$backup/metadata" | head -n 1)
	write_status applying "Applying the saved profile to vendor-supported cellular settings." "$target" "$backup"
	if ! apply_profile_config; then
		write_status rolling_back "Applying the profile failed; restoring the previous configuration." "$target" "$backup"
		restore_backup "$backup"
		write_status failed "Profile application failed. Automatic rollback was attempted." "$target" "$backup"
		return 1
	fi

	if [ "$old_sim" != "$target" ]; then
		write_status switching "Switching the SIM through the existing vendor mechanism." "$target" "$backup"
		if ! vendor_switch "$target" || ! wait_for_sim_ready; then
			write_status rolling_back "SIM switch did not become ready; restoring the previous SIM and configuration." "$target" "$backup"
			restore_backup "$backup"
			write_status failed "SIM switch failed. Automatic rollback was attempted." "$target" "$backup"
			return 1
		fi
	fi

	write_status waiting "Reloading cellular service and waiting for network registration." "$target" "$backup"
	if ! /etc/init.d/cellular reload || ! wait_for_registration; then
		write_status rolling_back "Network registration failed; restoring the previous SIM and configuration." "$target" "$backup"
		restore_backup "$backup"
		write_status failed "The selected SIM did not register. Automatic rollback was attempted." "$target" "$backup"
		return 1
	fi

	write_status success "$target profile is active and registered. The backup remains available for rollback." "$target" "$backup"
}

rollback_latest() {
	backup=$(cat "$latest_file" 2>/dev/null)
	acquire_lock "" "$backup" || return 1
	case "$backup" in "$backup_root"/*) ;; *)
		write_status failed "No valid rollback backup is available." "" ""
		return 1
		;;
	esac
	write_status rolling_back "Restoring the previous cellular configuration and active SIM." "" "$backup"
	if restore_backup "$backup"; then
		write_status rollback_complete "Previous cellular configuration and SIM were restored." "" "$backup"
		return 0
	fi
	write_status failed "Rollback did not complete. The backup remains untouched for manual recovery." "" "$backup"
	return 1
}

case "${1:-status}" in
	status) show_status ;;
	activate) activate_profile "${2:-}" ;;
	rollback) rollback_latest ;;
	*) printf 'Usage: %s {status|activate sim1|activate sim2|rollback}\n' "$0" >&2; exit 2 ;;
esac

