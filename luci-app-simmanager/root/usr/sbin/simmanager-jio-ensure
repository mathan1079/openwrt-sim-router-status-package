#!/bin/sh

# Idempotently prepare Quectel RM500U data service for Jio and other
# IPv6-only mobile networks that require the modem's built-in 464XLAT.

atdev="$1"
cell_section="${2:-cellular}"
iccid="$3"

[ -c "$atdev" ] || exit 1

profile=$(uci -q get "cellular.${cell_section}.hw_sim")
case "$profile" in sim1|sim2) ;; *) profile="" ;; esac

imsi=$(at-cmd "$atdev" AT+CIMI 2>/dev/null | tr -d '\r' | grep -E '^[0-9]{14,16}$' | head -n 1)
operator=$(at-cmd "$atdev" 'AT+COPS?' 2>/dev/null | tr -d '\r' | grep '+COPS:' | tail -n 1)
pdp_address=$(at-cmd "$atdev" 'AT+CGPADDR=1' 2>/dev/null | tr -d '\r' | grep '+CGPADDR:' | tail -n 1)

is_jio=0
case "$imsi" in 405869*) is_jio=1 ;; esac
echo "$operator" | grep -Eqi 'Jio|405869' && is_jio=1

is_ipv6_only=0
echo "$pdp_address" | grep -q ':' && is_ipv6_only=1
echo "$pdp_address" | grep -Eq '"[0-9]{1,3}(\.[0-9]{1,3}){3}"' && is_ipv6_only=0

if [ "$is_jio" != 1 ] && [ "$is_ipv6_only" != 1 ]; then
	rm -f "/tmp/simmanager-xlat-${cell_section}.state"
	exit 0
fi

marker="/tmp/simmanager-xlat-${cell_section}.state"
signature="v2|${iccid}|${imsi}|jionet|IPV4V6|nat1|clat1"
previous_signature=$(cat "$marker" 2>/dev/null)
nat=$(at-cmd "$atdev" 'AT+QCFG="nat"' 2>/dev/null | tr -d '\r' | sed -n 's/.*"nat",\([0-9][0-9]*\).*/\1/p' | tail -n 1)
clat=$(at-cmd "$atdev" 'AT+QCFG="clat"' 2>/dev/null | tr -d '\r' | sed -n 's/.*"clat",\([0-9][0-9]*\).*/\1/p' | tail -n 1)

if [ "$previous_signature" = "$signature" ] && [ "$nat" = 1 ] && [ "$clat" = 1 ]; then
	exit 0
fi

uci set "cellular.${cell_section}.m_apn_auto=0"
uci set "cellular.${cell_section}.m_apn=jionet"
uci set "cellular.${cell_section}.m_pdp=IPV4V6"
uci set "cellular.${cell_section}.m_netmode=AUTO"
uci commit cellular

if [ -n "$profile" ] && [ "$(uci -q get "simmanager.${profile}")" = profile ]; then
	uci set "simmanager.${profile}.apn_auto=0"
	uci set "simmanager.${profile}.apn=jionet"
	uci set "simmanager.${profile}.pdp_type=IPV4V6"
	uci set "simmanager.${profile}.network_mode=AUTO"
	uci commit simmanager
fi
sync

at-cmd "$atdev" 'AT+QNETDEVCTL=1,3,0' >/dev/null 2>&1
at-cmd "$atdev" 'AT+QCFG="CLAT",1,1,"",0,"ipv4only.arpa.",0,0,1,1,2,2' >/dev/null 2>&1 || exit 1
at-cmd "$atdev" 'AT+QCFG="nat",1' >/dev/null 2>&1 || exit 1
at-cmd "$atdev" 'AT+CGDCONT=1,"IPV4V6","jionet"' >/dev/null 2>&1 || exit 1
at-cmd "$atdev" 'AT+QNWPREFCFG="mode_pref",AUTO' >/dev/null 2>&1 || exit 1
printf '%s\n' "$signature" > "$marker"
logger -t simmanager-jio "Prepared ${profile:-active SIM} for IPv6-only service using RM500U CLAT and NAT."

if [ "$previous_signature" != "$signature" ] || [ "$nat" != 1 ]; then
	logger -t simmanager-jio "Restarting the RM500U once to activate CLAT for ${profile:-the active SIM}; the prepared ICCID marker prevents a restart loop."
	at-cmd "$atdev" 'AT+CFUN=1,1' >/dev/null 2>&1
	exit 10
fi

exit 0
