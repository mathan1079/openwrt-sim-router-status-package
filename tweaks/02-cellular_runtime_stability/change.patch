 #!/bin/sh
+count="$1" 
+instance_lock="/tmp/quectel_rm500u_${count}.lock"
+if ! mkdir "${instance_lock}" 2>/dev/null; then
+	old_pid=`cat "${instance_lock}/pid" 2>/dev/null`
+	if [ -n "${old_pid}" ] && kill -0 "${old_pid}" 2>/dev/null; then
+		logger -t simmanager-cellular-guard "Skipped duplicate RM500U worker for modem ${count}; PID ${old_pid} is already running."
+		exit 0
+	fi
+	rm -rf "${instance_lock}"
+	mkdir "${instance_lock}" 2>/dev/null || exit 1
+fi
+echo "$$" > "${instance_lock}/pid"
+release_instance_lock() {
+	lock_pid=`cat "${instance_lock}/pid" 2>/dev/null`
+	[ "${lock_pid}" = "$$" ] && rm -rf "${instance_lock}"
+}
+stop_worker() {
+	release_instance_lock
+	exit 0
+}
+trap release_instance_lock EXIT
+trap stop_worker HUP INT TERM
+
 . /lib/functions/cellular.sh
 . /lib/functions/esim.sh
 
+# The vendor dial helper treats one missing ping result as a reason to run
+# AT+CFUN=1 and ifup.  On this firmware, several processes share the AT port,
+# so a transient or crossed reply must never be allowed to bounce the link.
+quectel_asr_ecm_dial_safe() {
+	local atdev="$1"
+	local ifname="$2"
+	local network_section="$4"
+	local count="$5"
+	local check_ip net_stat qnetdev_ret check_dial
+
+	check_ip=`ifconfig "${ifname}" 2>/dev/null | grep "inet addr:" | awk -F 'Bcast:' '{print $1}' | cut -d ":" -f2 | sed 's/\ //g'`
+	net_stat=`grep -c "64 bytes" "/tmp/ping_cellular${count}" 2>/dev/null`
+	qnetdev_ret=`at-cmd "${atdev}" AT+QNETDEVCTL? 2>/dev/null | tr -d '\r'`
+	check_dial=`echo "${qnetdev_ret}" | grep '^+QNETDEVCTL: 1,' | sed -n '1p' | cut -d ':' -f2 | sed 's/ //g'`
+
+	if [ -z "${check_ip}" ]; then
+		logger -t simmanager-cellular-guard "${network_section} has no IPv4 address; requesting cellular-only DHCP recovery."
+		ifconfig "${ifname}" up
+		ifup "${network_section}"
+	elif [ "${net_stat:-0}" -le 0 ]; then
+		logger -t simmanager-cellular-guard "Ignored one empty/failed ping sample while ${network_section} still has ${check_ip}."
+	fi
+
+	case "${check_dial}" in
+		1,3,1)
+			;;
+		1,3,0)
+			logger -t simmanager-cellular-guard "RM500U data call is stopped; starting it without resetting the modem."
+			at-cmd "${atdev}" AT+QNETDEVCTL=1,3,1 >/dev/null 2>&1
+			;;
+		*)
+			logger -t simmanager-cellular-guard "Ignored invalid/crossed QNETDEVCTL reply; no interface or modem reset was performed."
+			;;
+	esac
+}
+
 ## NCM
 ## 支持模组：RM500U、RM500U-CNV、RG500U
 cellular_Program="$0"
-count="$1" 
 atdev="$2"
 ifname="$3"
 _ifname="$4"
