 	if [ "$physical_sim" != "$old_sim" ]; then
 		vendor_switch "$old_sim" || return 1
 		wait_for_sim_ready rollback || return 1
+		restored_switch=1
 	fi
-	/etc/init.d/cellular reload || return 1
-	return 0
+	[ "$restored_switch" = 1 ] || /etc/init.d/cellular reload || return 1
+	wait_for_stable_connectivity
 }
 
