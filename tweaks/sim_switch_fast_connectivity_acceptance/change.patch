--- original/usr/sbin/simmanager-control
+++ changed/usr/sbin/simmanager-control
@@ -15,6 +15,10 @@
 automatic_latest_file="$backup_root/automatic-latest"
 automatic_request=0
 at_lock=${SIMMANAGER_AT_LOCK:-/tmp/simmanager-at.lock}
+activation_probe_hosts=${SIMMANAGER_ACTIVATION_PROBES:-"1.1.1.1 8.8.8.8 9.9.9.9"}
+activation_monitor_interval=${SIMMANAGER_ACTIVATION_INTERVAL:-2}
+activation_required_successes=${SIMMANAGER_ACTIVATION_SUCCESSES:-2}
+activation_max_checks=${SIMMANAGER_ACTIVATION_MAX_CHECKS:-45}
 
 locked_at() {
 	(
@@ -197,6 +201,49 @@
 	return 1
 }
 
+cellular_device() {
+	json=$(ubus call network.interface.cellular status 2>/dev/null) || return 1
+	up=$(jsonfilter -s "$json" -e '@.up' 2>/dev/null)
+	[ "$up" = true ] || return 1
+	address=$(jsonfilter -s "$json" -e '@["ipv4-address"][0].address' 2>/dev/null)
+	[ -n "$address" ] || return 1
+	device=$(jsonfilter -s "$json" -e '@.l3_device' 2>/dev/null)
+	[ -n "$device" ] || device=$(jsonfilter -s "$json" -e '@.device' 2>/dev/null)
+	[ -n "$device" ] || return 1
+	printf '%s\n' "$device"
+}
+
+activation_health_check() {
+	device=$(cellular_device) || return 1
+	success=0
+	pids=""
+	for host in $activation_probe_hosts; do
+		ping -I "$device" -c 1 -W 2 "$host" >/dev/null 2>&1 &
+		pids="$pids $!"
+	done
+	for pid in $pids; do
+		wait "$pid" && success=$((success + 1))
+	done
+	[ "$success" -ge 2 ]
+}
+
+wait_for_stable_connectivity() {
+	checks=0
+	consecutive=0
+	while [ "$checks" -lt "$activation_max_checks" ]; do
+		automation_allowed || return 1
+		if activation_health_check; then
+			consecutive=$((consecutive + 1))
+			[ "$consecutive" -ge "$activation_required_successes" ] && return 0
+		else
+			consecutive=0
+		fi
+		checks=$((checks + 1))
+		[ "$checks" -lt "$activation_max_checks" ] && sleep "$activation_monitor_interval"
+	done
+	return 1
+}
+
