#!/bin/sh
. /lib/functions/cellular.sh

count="$1"
usb_hub="$2"
vidpid="$3"
dir='/usr/sbin/cellular'

option="${count}"
[ "${option}" == "1" ] && option=''
vid=`echo "${vidpid}" | cut -d ":" -f1`
pid=`echo "${vidpid}" | cut -d ":" -f2`

hw_section="cellular${option}"
net_section="cellular${option}"
cell_section="cellular${option}"
sys_section="cellular${option}"
info_section="info${option}"

# 1、获取信息
##  1.1、获取硬件相关信息
led=`uci get hw_info.${hw_section}.led 2> /dev/null`
phy=`uci get hw_info.${hw_section}.phy 2> /dev/null`
esim=`uci get hw_info.${hw_section}.esim 2> /dev/null`

## 1.2、获取网络相关信息
metric=`uci get hw_info.${hw_section}.metric 2> /dev/null`
phy_ifname=`uci get hw_info.${hw_section}.phy_ifname 2> /dev/null`
usb_ifname=`uci get hw_info.${hw_section}.usb_ifname 2> /dev/null`
dns=`uci get cellular.${cell_section}.dns 2> /dev/null`

## 传入硬件id
cellular_id
atdev=`get_atdev "${vidpid}" "${usb_hub}"`
if [ "${phy}" == '1' ] ;then 
	ifname="${phy_ifname}"
	_ifname=`get_ifname "${usb_hub}"`
	[ -z "${_ifname}" ] && _ifname="${usb_ifname}"
else 
	ifname=`get_ifname "${usb_hub}"`
	[ -z "${ifname}" ] && ifname="${usb_ifname}"
	_ifname="${ifname}"
fi

## 1.3、获得拨号脚本和esim脚本
cellular_Product=`get_cellProgram ${vidpid} | cut -d ":" -f1`
cellular_Program=`get_cellProgram ${vidpid} | cut -d ":" -f2`
[ -z "${cellular_Product}" ] && cellular_Product='USBNET'
[ -z "${cellular_Program}" ] && cellular_Program='usbnet_usb0'
esimDetail='cellular_esimDetail'
esimUpload='cellular_esimUpload'
esimOper='cellular_esimOper'
esimCloud='cellular_esimCloud'
esimApp='cellular_esimApp'

# 2、配置
## 2.1、硬件配置
uci set system.${sys_section}.dev="${_ifname}"
## 2.2、配置RPS，将网卡数据包均衡分到每个CPU核心上
echo '4096' > /sys/class/net/${ifname}/queues/rx-0/rps_flow_cnt
echo '3' > /sys/class/net/${ifname}/queues/rx-0/rps_cpus

## 2.2、模组信息配置
uci set cellular.${cell_section}.atdev="${atdev}"
uci set cellular.${cell_section}.ifname="${ifname}"
uci set cellular.${cell_section}._ifname="${_ifname}"
uci set cellular.${cell_section}.model="${cellular_Product}"
uci set device_modem_info.${info_section}.ttyUSB="${atdev}"
uci set cellular.${cell_section}.script="${dir}/${cellular_Program} ${count} ${atdev} ${ifname} ${_ifname} ${phy} ${esim}"
uci set cellular.${cell_section}.esimDetail="${dir}/${esimDetail} ${count} ${atdev}"
uci set cellular.${cell_section}.esimUpload="${dir}/${esimUpload} ${count} ${atdev}"
uci set cellular.${cell_section}.esimOper="${dir}/${esimOper} ${count} ${atdev}"
uci set cellular.${cell_section}.esimCloud="${dir}/${esimCloud} ${count} ${atdev}"
uci set cellular.${cell_section}.esimApp="${dir}/${esimApp} ${count} ${atdev}"

## 2.3、网络配置
config_script=`uci get network.${net_section}.script 2>/dev/null`
[ "${config_script}" != "${cellular_Program}" ] && \   
network_config "${cellular_Program}" "${metric}" "${net_section}" "${_ifname}" "${dns}" && \
/etc/init.d/network reload

uci commit && sync
/etc/init.d/mwan3 restart
/etc/init.d/led reload

# 3、脚本
## 3.1、执行esim脚本
m_esim=`uci get cellular.${cell_section}.m_esim 2> /dev/null`
if [ "${esim}" == '1' ] && [ "${m_esim}" == '1' ] ;then
	esimDetail=`uci get cellular.${cell_section}.esimDetail 2> /dev/null`
	${esimDetail}
fi
sleep 2

## 3.2、重新激活模组
module_reactivation "${atdev}"

## 3.3、执行拨号脚本
cellular_Program=`uci get cellular.${cell_section}.script 2> /dev/null`
${cellular_Program} &

exit 0
