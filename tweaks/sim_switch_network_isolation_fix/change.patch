--- original/usr/sbin/cellular/cellular_Prepare
+++ changed/usr/sbin/cellular/cellular_Prepare
@@ -1,7 +1,24 @@
 #!/bin/sh
+count="$1"
+prepare_lock="/tmp/cellular_Prepare_${count}.lock"
+if ! mkdir "${prepare_lock}" 2>/dev/null; then
+	old_pid=`cat "${prepare_lock}/pid" 2>/dev/null`
+	if [ -n "${old_pid}" ] && kill -0 "${old_pid}" 2>/dev/null; then
+		logger -t simmanager-cellular-guard "Skipped duplicate modem preparation for modem ${count}; PID ${old_pid} is already running."
+		exit 0
+	fi
+	rm -rf "${prepare_lock}"
+	mkdir "${prepare_lock}" 2>/dev/null || exit 1
+fi
+echo "$$" > "${prepare_lock}/pid"
+release_prepare_lock() {
+	lock_pid=`cat "${prepare_lock}/pid" 2>/dev/null`
+	[ "${lock_pid}" = "$$" ] && rm -rf "${prepare_lock}"
+}
+trap release_prepare_lock EXIT HUP INT TERM
+
 . /lib/functions/cellular.sh
 
