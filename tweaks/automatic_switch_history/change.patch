+history_reason_text() {
+	case "$1" in
+		sustained_outage) printf '%s\n' "Connectivity failed continuously for the configured duration." ;;
+		reconnect_loop) printf '%s\n' "Frequent disconnect threshold was reached inside the observation window." ;;
+		secondary_failed) printf '%s\n' "The active secondary SIM lost proved connectivity." ;;
+		scheduled_primary_retry) printf '%s\n' "The scheduled default-SIM return test became due." ;;
+		*) printf '%s\n' "Automatic switching policy requested a SIM change." ;;
