+<style>
+.simmanager-auto-history { margin-top: 18px; border: 1px solid #d8dce2; border-radius: 7px; background: #fff; padding: 16px; }
+.simmanager-auto-history h3 { margin: 0; }
+.simmanager-auto-history-head { display: flex; justify-content: space-between; align-items: flex-start; gap: 16px; margin-bottom: 14px; }
+.simmanager-auto-history-head p { margin: 6px 0 0; color: #667085; line-height: 1.45; }
+.simmanager-auto-history-actions { display: flex; gap: 8px; flex-wrap: wrap; }
+.simmanager-auto-history-actions .cbi-button { margin: 0; }
+.simmanager-auto-history-wrap { overflow-x: auto; border: 1px solid #e1e5eb; border-radius: 6px; }
+.simmanager-auto-history-table { width: 100%; min-width: 980px; border-collapse: collapse; }
+.simmanager-auto-history-table th, .simmanager-auto-history-table td { padding: 10px 9px; border-bottom: 1px solid #e7eaf0; text-align: left; vertical-align: top; }
+.simmanager-auto-history-table th { background: #f7f8fa; color: #344054; font-weight: 600; white-space: nowrap; }
+.simmanager-auto-history-table tr:last-child td { border-bottom: 0; }
+.simmanager-auto-history-table .history-check { width: 34px; text-align: center; }
+.simmanager-auto-history-table .history-direction { white-space: nowrap; font-weight: 600; }
+.simmanager-auto-history-table .history-time { white-space: nowrap; }
+.simmanager-auto-history-table .history-reason { min-width: 240px; line-height: 1.4; }
+.simmanager-history-outcome { display: inline-block; padding: 3px 8px; border-radius: 12px; background: #eef2f6; white-space: nowrap; }
+.simmanager-history-outcome.good { color: #08783e; background: #dff6e8; }
+.simmanager-history-outcome.bad { color: #b42318; background: #fee4e2; }
+.simmanager-history-outcome.warn { color: #92400e; background: #fef3c7; }
+.simmanager-auto-history-details td { padding: 0 !important; background: #f8fafc; }
+.simmanager-auto-history-detail-grid { display: grid; grid-template-columns: repeat(3, minmax(180px, 1fr)); gap: 0; padding: 8px 12px 14px; }
+.simmanager-auto-history-detail { padding: 8px 10px; border-bottom: 1px solid #e7eaf0; overflow-wrap: anywhere; }
+.simmanager-auto-history-detail span { display: block; color: #667085; font-size: .9em; margin-bottom: 3px; }
+.simmanager-auto-history-detail strong { font-weight: 500; }
+.simmanager-auto-history-empty { padding: 26px 12px !important; text-align: center !important; color: #667085; }
+.simmanager-auto-history-pagination { display: flex; justify-content: space-between; align-items: center; gap: 12px; margin-top: 12px; }
+.simmanager-auto-history-pagination-buttons { display: flex; gap: 8px; }
+.simmanager-auto-history-pagination .cbi-button { margin: 0; }
+@media (max-width: 900px) {
+	.simmanager-auto-history-head { flex-direction: column; }
+	.simmanager-auto-history-detail-grid { grid-template-columns: repeat(2, minmax(160px, 1fr)); }
+}
+@media (max-width: 600px) {
+	.simmanager-auto-history-detail-grid { grid-template-columns: 1fr; }
+}
+</style>
+
+<div class="simmanager-auto-history">
+	<div class="simmanager-auto-history-head">
+		<div>
+			<h3><%:Automatic switch history%></h3>
+			<p><%:Records are stored persistently and remain available after a router restart. Each record contains the trigger evidence, policy snapshot, timing, result and rollback outcome.%></p>
+		</div>
+		<div class="simmanager-auto-history-actions">
+			<button type="button" id="auto-history-refresh" class="cbi-button"><%:Refresh%></button>
+			<button type="button" id="auto-history-delete" class="cbi-button cbi-button-negative" disabled><%:Delete selected%></button>
+		</div>
+	</div>
+
+	<div class="simmanager-auto-history-wrap">
+		<table class="simmanager-auto-history-table">
+			<thead>
+				<tr>
+					<th class="history-check"><input type="checkbox" id="auto-history-select-page" title="<%:Select this page%>"></th>
+					<th><%:Reason%></th>
+					<th><%:SIM change%></th>
+					<th><%:Start time%></th>
+					<th><%:End time%></th>
+					<th><%:Duration%></th>
+					<th><%:Outcome%></th>
+					<th><%:Details%></th>
+				</tr>
+			</thead>
+			<tbody id="auto-history-body"><tr><td colspan="8" class="simmanager-auto-history-empty"><%:Loading automatic switch history…%></td></tr></tbody>
+		</table>
+	</div>
+
+	<div class="simmanager-auto-history-pagination">
+		<span id="auto-history-page-label"><%:Page%> 1 / 1</span>
+		<div class="simmanager-auto-history-pagination-buttons">
+			<button type="button" id="auto-history-previous" class="cbi-button" disabled><%:Previous%></button>
+			<button type="button" id="auto-history-next" class="cbi-button" disabled><%:Next%></button>
+		</div>
+	</div>
+</div>
+
+<script type="text/javascript">
+//<![CDATA[
+(function() {
+	var token = '<%=token%>';
+	var listUrl = '<%=luci.dispatcher.build_url("admin", "simmanager", "auto_history")%>';
+	var deleteUrl = '<%=luci.dispatcher.build_url("admin", "simmanager", "auto_history_delete")%>';
+	var pageSize = 10;
+	var page = 1;
+	var records = [];
+	var selected = {};
+	var expanded = {};
+
+	function parse(xhr, data) {
+		if (data) return data;
+		try { return JSON.parse(xhr.responseText); } catch (e) { return {}; }
+	}
+
+	function formatTime(epoch) {
+		if (window.simmanagerFormatLocalTime) return window.simmanagerFormatLocalTime(epoch);
+		var date = new Date(Number(epoch) * 1000);
+		if (!Number(epoch) || isNaN(date.getTime())) return '—';
+		return date.toLocaleString();
+	}
+
+	function text(value, fallback) {
+		return value === undefined || value === null || value === '' ? (fallback || '—') : String(value);
+	}
+
+	function outcomeLabel(record) {
+		if (record.in_progress) return '<%:In progress%>';
+		var labels = {
+			switched: '<%:Switched successfully%>',
+			activation_failed: '<%:Activation failed%>',
+			target_unhealthy_rollback_restored: '<%:Rolled back%>',
+			rollback_failed: '<%:Rollback failed%>',
+			interrupted: '<%:Interrupted%>'
+		};
+		return labels[record.outcome] || text(record.outcome, '<%:Unknown%>');
+	}
+
+	function outcomeClass(record) {
+		if (record.outcome === 'switched') return ' good';
+		if (record.outcome === 'rollback_failed') return ' bad';
+		if (record.in_progress || record.outcome === 'interrupted' || record.outcome === 'target_unhealthy_rollback_restored') return ' warn';
+		return '';
+	}
+
+	function cell(row, className, value) {
+		var node = document.createElement('td');
+		if (className) node.className = className;
+		node.textContent = value;
+		row.appendChild(node);
+		return node;
+	}
+
+	function addDetail(container, label, value) {
+		var item = document.createElement('div');
+		item.className = 'simmanager-auto-history-detail';
+		var title = document.createElement('span');
+		title.textContent = label;
+		var content = document.createElement('strong');
+		content.textContent = text(value);
+		item.appendChild(title);
+		item.appendChild(content);
+		container.appendChild(item);
+	}
+
+	function detailRow(record) {
+		var row = document.createElement('tr');
+		row.className = 'simmanager-auto-history-details';
+		var cellNode = document.createElement('td');
+		cellNode.colSpan = 8;
+		var grid = document.createElement('div');
+		grid.className = 'simmanager-auto-history-detail-grid';
+		addDetail(grid, '<%:Record ID%>', record.id);
+		addDetail(grid, '<%:Reason code%>', record.reason_code);
+		addDetail(grid, '<%:Final SIM%>', String(record.final_sim || 'unknown').toUpperCase());
+		addDetail(grid, '<%:Failure duration at trigger%>', text(record.failure_elapsed_seconds, '0') + ' <%:seconds%>');
+		addDetail(grid, '<%:Configured failure threshold%>', text(record.failure_threshold_seconds) + ' <%:seconds%>');
+		addDetail(grid, '<%:Disconnect events%>', text(record.disconnect_events, '0') + ' / ' + text(record.disconnect_threshold));
+		addDetail(grid, '<%:Disconnect observation window%>', text(record.disconnect_window_minutes) + ' <%:minutes%>');
+		addDetail(grid, '<%:Probe family%>', record.probe_family);
+		addDetail(grid, '<%:Probe result%>', text(record.probe_successes, '0') + ' / 3 (' + '<%:minimum%>' + ' ' + text(record.probe_required_successes) + ') — ' + text(record.probe_results));
+		addDetail(grid, '<%:Probe hosts%>', record.probe_hosts);
+		addDetail(grid, '<%:Source interface%>', record.source_interface);
+		addDetail(grid, '<%:Daily attempt%>', text(record.daily_attempt_number) + ' / ' + text(record.daily_attempt_limit));
+		addDetail(grid, '<%:Default SIM%>', String(record.default_sim || 'unknown').toUpperCase());
+		addDetail(grid, '<%:Target PDP type%>', record.target_pdp_type);
+		addDetail(grid, '<%:Target APN mode%>', record.target_apn_mode);
+		addDetail(grid, '<%:Target APN%>', record.target_apn);
+		addDetail(grid, '<%:Operator at trigger%>', record.trigger_operator);
+		addDetail(grid, '<%:MCC/MNC at trigger%>', record.trigger_mccmnc);
+		addDetail(grid, '<%:Registration at trigger%>', record.trigger_registration);
+		addDetail(grid, '<%:Signal at trigger%>', text(record.trigger_signal_percent) + '% / RSRP ' + text(record.trigger_rsrp));
+		addDetail(grid, '<%:Band at trigger%>', record.trigger_band);
+		addDetail(grid, '<%:Cell ID at trigger%>', record.trigger_cell_id);
+		addDetail(grid, '<%:ICCID at trigger%>', record.trigger_iccid);
+		addDetail(grid, '<%:APN at trigger%>', record.trigger_apn);
+		addDetail(grid, '<%:Controller state%>', record.control_state);
+		addDetail(grid, '<%:Controller message%>', record.control_message);
+		addDetail(grid, '<%:Result message%>', record.message);
+		cellNode.appendChild(grid);
+		row.appendChild(cellNode);
+		return row;
+	}
+
+	function currentPageRecords() {
+		var start = (page - 1) * pageSize;
+		return records.slice(start, start + pageSize);
+	}
+
+	function updateActions() {
+		var count = 0;
+		for (var id in selected) if (selected[id]) count++;
+		document.getElementById('auto-history-delete').disabled = count === 0;
+		var visible = currentPageRecords().filter(function(record) { return record.deletable; });
+		var checked = visible.length > 0;
+		for (var i = 0; i < visible.length; i++) if (!selected[visible[i].id]) checked = false;
+		document.getElementById('auto-history-select-page').checked = checked;
+	}
+
+	function render() {
+		var body = document.getElementById('auto-history-body');
+		body.textContent = '';
+		var totalPages = Math.max(1, Math.ceil(records.length / pageSize));
+		if (page > totalPages) page = totalPages;
+		var visible = currentPageRecords();
+
+		if (!visible.length) {
+			var empty = document.createElement('tr');
+			cell(empty, 'simmanager-auto-history-empty', '<%:No automatic switch records are available.%>').colSpan = 8;
+			body.appendChild(empty);
+		}
+
+		visible.forEach(function(record) {
+			var row = document.createElement('tr');
+			var checkCell = document.createElement('td');
+			checkCell.className = 'history-check';
+			var checkbox = document.createElement('input');
+			checkbox.type = 'checkbox';
+			checkbox.setAttribute('data-history-id', record.id);
+			checkbox.checked = !!selected[record.id];
+			checkbox.disabled = !record.deletable;
+			checkCell.appendChild(checkbox);
+			row.appendChild(checkCell);
+			cell(row, 'history-reason', text(record.reason));
+			cell(row, 'history-direction', String(record.from_sim || '?').toUpperCase() + ' → ' + String(record.target_sim || '?').toUpperCase());
+			cell(row, 'history-time', formatTime(record.started_at));
+			cell(row, 'history-time', record.in_progress ? '<%:In progress%>' : formatTime(record.ended_at));
+			cell(row, '', record.in_progress ? '—' : text(record.duration_seconds, '0') + 's');
+			var outcomeCell = document.createElement('td');
+			var badge = document.createElement('span');
+			badge.className = 'simmanager-history-outcome' + outcomeClass(record);
+			badge.textContent = outcomeLabel(record);
+			outcomeCell.appendChild(badge);
+			row.appendChild(outcomeCell);
+			var actionCell = document.createElement('td');
+			var detailButton = document.createElement('button');
+			detailButton.type = 'button';
+			detailButton.className = 'cbi-button';
+			detailButton.setAttribute('data-history-detail', record.id);
+			detailButton.textContent = expanded[record.id] ? '<%:Hide%>' : '<%:View%>';
+			actionCell.appendChild(detailButton);
+			row.appendChild(actionCell);
+			body.appendChild(row);
+			if (expanded[record.id]) body.appendChild(detailRow(record));
+		});
+
+		document.getElementById('auto-history-page-label').textContent = '<%:Page%> ' + page + ' / ' + totalPages + ' — ' + records.length + ' <%:records%>';
+		document.getElementById('auto-history-previous').disabled = page <= 1;
+		document.getElementById('auto-history-next').disabled = page >= totalPages;
+		updateActions();
+	}
+
+	function loadHistory() {
+		XHR.get(listUrl, null, function(xhr, data) {
+			data = parse(xhr, data);
+			records = data && data.records instanceof Array ? data.records : [];
+			render();
+		});
+	}
+
+	document.getElementById('auto-history-body').addEventListener('change', function(event) {
+		var id = event.target.getAttribute('data-history-id');
+		if (!id) return;
+		selected[id] = event.target.checked;
+		updateActions();
+	});
+
+	document.getElementById('auto-history-body').addEventListener('click', function(event) {
+		var id = event.target.getAttribute('data-history-detail');
+		if (!id) return;
+		expanded[id] = !expanded[id];
+		render();
+	});
+
+	document.getElementById('auto-history-select-page').addEventListener('change', function() {
+		var checked = this.checked;
+		currentPageRecords().forEach(function(record) { if (record.deletable) selected[record.id] = checked; });
+		render();
+	});
+
+	document.getElementById('auto-history-delete').addEventListener('click', function() {
+		var ids = [];
+		for (var id in selected) if (selected[id]) ids.push(id);
+		if (!ids.length || !window.confirm('<%:Delete the selected automatic switch records? This cannot be undone.%>')) return;
+		this.disabled = true;
+		XHR.post(deleteUrl, { token: token, ids: ids.join(',') }, function(xhr, data) {
+			data = parse(xhr, data);
+			if (data.ok === false) alert(data.error || '<%:The records could not be deleted.%>');
+			selected = {};
+			loadHistory();
+		});
+	});
+
+	document.getElementById('auto-history-refresh').addEventListener('click', loadHistory);
+	document.getElementById('auto-history-previous').addEventListener('click', function() { if (page > 1) { page--; render(); } });
+	document.getElementById('auto-history-next').addEventListener('click', function() { if (page * pageSize < records.length) { page++; render(); } });
+
+	loadHistory();
+	window.setInterval(loadHistory, 10000);
+})();
+//]]>
+</script>
diff -ruN tweaks/automatic_switch_history/original/usr/sbin/simmanager-auto tweaks/automatic_switch_history/changed/usr/sbin/simmanager-auto
