@@ -12,20 +12,199 @@
 state_root=${SIMMANAGER_AUTO_STATE_ROOT:-/etc/simmanager}
 state_file=$state_root/auto-state
 state_new=$state_root/auto-state.new
+history_root=${SIMMANAGER_AUTO_HISTORY_ROOT:-/etc/simmanager/auto-history}
