#!/bin/sh /etc/rc.common

START=99
STOP=10
USE_PROCD=1

start_service() {
	[ "$(uci -q get simmanager.automation.enabled)" = "1" ] || return 0
	if [ "$(uci -q get cellular.cellular.hw_asw)" = "1" ]; then
		/usr/sbin/simmanager-auto vendor-conflict
		return 0
	fi
	procd_open_instance
	procd_set_param command /usr/sbin/simmanager-auto run
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param term_timeout 10
	# Recover from an unexpected controller exit, but stop after a sustained
	# crash loop so a broken installation cannot consume the router forever.
	procd_set_param respawn 3600 5 5
	procd_close_instance
}

service_triggers() {
	# The monitor reads cellular state every five seconds. Reloading it for every
	# cellular change can interrupt its own guarded activation transaction.
	procd_add_reload_trigger "simmanager"
}

reload_service() {
	stop
	start
}
