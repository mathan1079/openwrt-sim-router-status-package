#!/bin/sh
. /lib/functions/cellular.sh
. /lib/functions/esim.sh

## NCM
## 支持模组：RM500U、RM500U-CNV、RG500U
cellular_Program="$0"
count="$1" 
atdev="$2"
ifname="$3"
_ifname="$4"
phy="$5"
esim="$6"

option="${count}"
[ "${option}" == "1" ] && option=''
hw_section="cellular${option}"
net_section="cellular${option}"
cell_section="cellular${option}"
sys_section="cellular${option}"
dir='/usr/sbin/cellular'

_pcie_mode='1'
_eth_mode="${phy}"
_usbnet='5'
dial_Program='quectel_asr_ecm_dial'

## 打开回显功能
## at-cmd "${atdev}" ATE1
## at-cmd "${atdev}" AT\&W

## 获取具体模组型号
while true
do
    vendor=$(at-cmd "${atdev}" AT+CGMI | sed -n '2p' | tr -d '\r')
    ## gmm=$(at-cmd "${atdev}" AT+GMM | tr -d '\r')
    gmm=$(at-cmd "${atdev}" AT+GMM)
	gmm_exist=`echo "${gmm}" | sed -n 1p | grep "AT+GMM" | wc -l`

	if [ "${gmm_exist}" == '0' ] || [ "${vendor}" != "Quectel" ] ;then
		sleep 1
		continue
	else 
		 _model=`echo "${gmm}" | sed -n 2p | tr -d '\r'`
		model=`echo "${gmm}" | sed -n 2p | tr '[A-Z]' '[a-z]' | sed 's/\-/_/g' | tr -d '\r'`
		break
	fi
done

uci set cellular.${cell_section}.idevice_model="${model}"
uci commit && sync

## 网络配置
if [ "${phy}" == '1' ] ; then
	uci set network.${net_section}.ifname=${ifname} && \
	uci commit && sync && \
	/etc/init.d/network reload

	uci set system.${sys_section}.dev="${ifname}" && \
	uci commit && sync && \
	/etc/init.d/led reload
fi

## 循环获取实时信息
while true
do
	cfun_flags='0'
	### 判断模组是否启动
	module_exist=`ls "${atdev}" | wc -l`
	if [ "${module_exist}" == '0' ];then
		sleep 1
		continue
	fi
	### 判断模组AT是否正常
	at_exist=`at-cmd "${atdev}" ATI | grep "Revision" | wc -l`
	if [ "${at_exist}" == '0' ];then
		sleep 1
		continue
	fi

    ### 打开PCIE
    pcie_mode_ret=`at-cmd "${atdev}" AT+QCFG=\"pcie/mode\" 2> /dev/null`
    pcie_mode_result=`echo "${pcie_mode_ret}" | grep "OK" | wc -l`
    pcie_mode=`echo "${pcie_mode_ret}" | grep "+QCFG:" | cut -d "," -f2 | tr -d '\r'`
    if [ "${pcie_mode_result}" == "1" ] && [ "${pcie_mode}" != "${_pcie_mode}" ];then
        at-cmd "${atdev}" AT+QCFG=\"pcie/mode\",${_pcie_mode}
        cfun_flags='1'
    fi

    ### 打开ETH功能
    eth_mode_ret=`at-cmd "${atdev}" AT+QCFG=\"ethernet\" 2> /dev/null`
    eth_mode_result=`echo "${eth_mode_ret}" | grep "OK" | wc -l`
    eth_mode=`echo "${eth_mode_ret}" | grep "+QCFG:" | cut -d "," -f2 | tr -d '\r'`
    if [ "${eth_mode_result}" == "1" ] && [ "${eth_mode}" != "${_eth_mode}" ];then
        at-cmd "${atdev}" AT+QCFG=\"ethernet\",${_eth_mode}
        cfun_flags='1'
    fi

    ### 拨号设置
    usbnet_ret=`at-cmd "${atdev}" AT+QCFG=\"usbnet\" 2> /dev/null`
    usbnet_result=`echo "${usbnet_ret}" | grep "OK" | wc -l`
    usbnet=`echo "${usbnet_ret}" | grep "+QCFG:" | cut -d "," -f2 | tr -d '\r'`
    if [ "${usbnet_result}" == "1" ] && [ "${usbnet}" != "${_usbnet}" ];then
        at-cmd "${atdev}" AT+QCFG=\"usbnet\",${_usbnet}
        cfun_flags='1'
    fi

	### 配置COPS输出格式
	cops_format=$(at-cmd "${atdev}" AT+COPS? | sed -n '2p' | cut -d ' ' -f2 | cut -d '"' -f1 | sed 's/,//g' | tr -d '\r')
	## if [ "${cops_format}" == "02" ] || [ "${cops_format}" == "01" ];then
	at-cmd "${atdev}" AT+COPS=3,0
	## fi

	### 重启模组
	if [ "${cfun_flags}" == '1' ];then              
		cfun_flags='0'
		at-cmd "${atdev}" AT+CFUN=1,1    
 		sleep 10  
		continue     
    fi

	### 模组基本信息
    imei=$(at-cmd "${atdev}" AT+GSN | sed -n '2p' | tr -d '\r')
    iccid=$(at-cmd "${atdev}" AT+CCID | grep "+CCID:" | cut -d ":" -f2 | sed 's/\ //g' | tr -d '\r')
    iccid_len=$(echo "${iccid}" | wc -L)
    if [ "${iccid_len}" != "20" ] && [ "${iccid_len}" != "19" ] ;then
        iccid="NO SIM"
        cpin="None"
        isp="None"
        signal="0"
    else
		### 拨号
		m_pdp=`uci get cellular.${cell_section}.m_pdp 2> /dev/null`
		pdp_type="${m_pdp}"
		${dial_Program} "${atdev}" "${ifname}" "${pdp_type}" "${net_section}" "${option}"

        ### 运营商信息
        cgreg=$(at-cmd "${atdev}" AT+CGREG? | sed -n '2p' | cut -d ',' -f2 | sed 's/ //g' | tr -d '\r')
        apn=$(at-cmd "${atdev}" AT+CGDCONT? | grep "+CGDCONT: 1," | cut -d '"' -f4 | tr -d '\r')
        cpin=$(at-cmd "${atdev}" AT+CPIN? | sed -n '2p'|cut -d ':' -f2 | sed 's/ //g' | tr -d '\r')
		oper=$(at-cmd "${atdev}" AT+QNWINFO | grep "+QNWINFO:" | sed -n 1p | cut -d "," -f2 | sed 's/\"//g' | tr -d '\r')
		mcc=$(echo "${oper}" | cut -c 1-3)
		mnc=$(echo "${oper}" | cut -c 4-5)
		mccmnc="${mcc}|${mnc}"
		carrier=$(at-cmd "${atdev}" AT+COPS? | grep "+COPS:" | sed -n 1p | cut -d '"' -f2 | tr -d '\r')
        isp=$(at-cmd "${atdev}" AT+COPS? | grep "+COPS:" | cut -d '"' -f2 | tr -d '\r')
        isp_dect=$(echo "${isp}" | grep "COPS")
        if [ -n "${isp_dect}" ];then
            isp="No Service"
        fi

        ### 自动APN
		apn_auto=`uci get cellular.${cell_section}.m_apn_auto 2> /dev/null`
		if [ "${apn_auto}" == '1' ] ;then
			m_apn=`get_apn_by_apnlist "${carrier}" "${mccmnc}"`
			if [ -n "${m_apn}" ] ;then
				uci set cellular.${cell_section}.m_apn="${m_apn}"                      
                uci commit cellular && sync
				device_model=`uci get cellular_info.${model}.device_model 2> /dev/null`
				_device_model=`echo "${device_model}" | cut -d " " -f2 | cut -d "-" -f1`
				apn_pdp_set "${_device_model}" "${model}" "${atdev}" "${option}" 
			fi
		fi

        ### 注网信息
        nwmode=$(at-cmd "${atdev}" AT+COPS? | sed -n '2p' | cut -d ',' -f4 | tr -d '\r')
        qeng=$(at-cmd "${atdev}" AT+QENG=\"servingcell\")
        net_type=$(echo "${qeng}" | sed -n '2p' | awk -F ':' '{print $2}' | awk -F ',' '{print $3}' | tr -d '"\r')
        net_line=$(echo "${qeng}" |  grep "+QENG:" | wc -l)
        if [ "${net_type}" == "NR5G-SA" ];then
            rsrp=$(echo "${qeng}" | sed -n '2p' | awk -F ':' '{print $2}' | awk -F ',' '{print $13}' | tr -d '"\r')
            pcid=$(echo "${qeng}" | sed -n '2p' | awk -F ':' '{print $2}' | awk -F ',' '{print $8}' | tr -d '"\r')
            cellid=$(echo "${qeng}" | sed -n '2p' | awk -F ':' '{print $2}' | awk -F ',' '{print $7}' | tr -d '"\r')
            freq=$(echo "${qeng}" | sed -n '2p' | awk -F ':' '{print $2}' | awk -F ',' '{print $10}' | tr -d '"\r')
        elif [ "${net_line}" == 3 ];then
            ### net_type=NR5G-NSA
            rsrp=$(echo "${qeng}" | sed -n '4p' | awk -F ':' '{print $2}' | awk -F ',' '{print $5}' | tr -d '"\r')
            pcid=$(echo "${qeng}" | sed -n '4p' | awk -F ':' '{print $2}' | awk -F ',' '{print $4}' | tr -d '"\r')
            cellid=$(echo "${qeng}" | sed -n '4p' | awk -F ':' '{print $2}' | awk -F ',' '{print $5}' | tr -d '"\r')
            freq=$(echo "${qeng}" | sed -n '4p' | awk -F ':' '{print $2}' | awk -F ',' '{print $8}' | tr -d '"\r')
        elif [ "${net_type}" == "LTE" ];then
            rsrp=$(echo "${qeng}" | sed -n '2p' | awk -F ':' '{print $2}' | awk -F ',' '{print $14}' | tr -d '"\r')
            pcid=$(echo "${qeng}" | sed -n '2p' | awk -F ':' '{print $2}' | awk -F ',' '{print $8}' | tr -d '"\r')
            cellid=$(echo "${qeng}" | sed -n '2p' | awk -F ':' '{print $2}' | awk -F ',' '{print $7}' | tr -d '"\r')
            freq=$(echo "${qeng}" | sed -n '2p' | awk -F ':' '{print $2}' | awk -F ',' '{print $9}' | tr -d '"\r')
        elif [ "${net_type}" == "WCDMA" ];then
            rsrp=$(echo "${qeng}" | sed -n '2p' | awk -F ':' '{print $2}' | awk -F ',' '{print $11}' | tr -d '"\r')
            cellid=$(echo "${qeng}" | sed -n '2p' | awk -F ':' '{print $2}' | awk -F ',' '{print $7}' | tr -d '"\r')
        fi

        ### 信号强度
        if [ "${rsrp}" -ge "-44" ];then
            signal=100
        elif [ "${rsrp}" -ge "-85" ];then
            csq_temp=80
            csq_rsrp=$(printf "%d" $(((${rsrp}-(-85))*20/41)))
            signal=$(expr "${csq_temp}" + "${csq_rsrp}")
        elif [ "${rsrp}" -ge "-95" ];then
            csq_temp=60
            csq_rsrp=$(printf "%d" $(((${rsrp}-(-95))*20/10)))
            signal=$(expr "${csq_temp}" + "${csq_rsrp}")
        elif [ "${rsrp}" -ge "-105" ];then
            csq_temp=40
            csq_rsrp=$(printf "%d" $(((${rsrp}-(-105))*20/10)))
            signal=$(expr "${csq_temp}" + "${csq_rsrp}")
        elif [ "${rsrp}" -ge "-115" ];then
            csq_temp=20
            csq_rsrp=$(printf "%d" $(((${rsrp}-(-115))*20/10)))
            signal=$(expr "${csq_temp}" + "${csq_rsrp}")
        elif [ "${rsrp}" -lt "-115" ];then
            csq_temp=0
            csq_rsrp=$(printf "%d" $(((${rsrp}-(-140))*20/25)))
            signal=$(expr "${csq_temp}" + "${csq_rsrp}")
        else
            signal=0
        fi

        ### 当前搜网模式
        nwscanmode=`at-cmd "${atdev}" AT+QNWPREFCFG=\"mode_pref\" | sed -n 2p | cut -d ',' -f2 | tr -d '\r'`
		### 当前Band
        currband=`at-cmd "${atdev}" AT+QNWINFO | grep "+QNWINFO:" | cut -d "," -f3 | sed 's/\"//g' | tr -d '\r'`
        ### 支持的band
        gwbandval=`at-cmd "${atdev}" AT+QNWPREFCFG=\"gw_band\" | sed -n 2p | cut -d ',' -f2 | tr -d '\r'`
        ltebandval=`at-cmd "${atdev}" AT+QNWPREFCFG=\"lte_band\" | sed -n 2p | cut -d ',' -f2 | tr -d '\r'`
        nr5gbandval=`at-cmd "${atdev}" AT+QNWPREFCFG=\"nr5g_band\" | sed -n 2p | cut -d ',' -f2 | tr -d '\r'`
    fi
    
## 输出json
    . /usr/share/libubox/jshn.sh
    json_init
    json_add_string "device_model" "${vendor} ${_model}"
    json_add_string "imei" "${imei}"
    json_add_string "iccid" "${iccid}"
    json_add_string "apn" "${apn}"
    json_add_string "pin" "${cpin}"
    json_add_string "isp" "${isp}"
    json_add_string "mccmnc" "${mccmnc}"
    json_add_string "rsrp" "${rsrp}"
    json_add_string "signal" "${signal}"
    json_add_string "nwmode" "${nwmode}"
    json_add_string "pcid" "${pcid}"
    json_add_string "cellid" "${cellid}"
    json_add_string "freq" "${freq}"
    json_add_string "currband" "$(printf '%s' "${currband}" | tr '\n' ' ')"
    json_add_string "cgreg" "${cgreg}"
    json_add_string "scanmode" "$(printf '%s' "${nwscanmode}" | tr -d '"')"
    json_add_string "gwbandval" "${gwbandval}"
    json_add_string "ltebandval" "${ltebandval}"
    json_add_string "nsanr5gbandval" "${nsanr5gbandval}"
    json_add_string "nr5gbandval" "${nr5gbandval}"
    if json_dump > "/tmp/4ginfo${option}.new"; then
        mv -f "/tmp/4ginfo${option}.new" "/tmp/4ginfo${option}"
    fi
    json_cleanup
    sleep 8
done
