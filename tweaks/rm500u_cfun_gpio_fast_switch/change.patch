 vendor_switch() {
 	target="$1"
+	if [ -x /usr/sbin/simmanager-fast-switch ]; then
+		/usr/sbin/simmanager-fast-switch "$target" 1
+		fast_status=$?
+		[ "$fast_status" = 0 ] && return 0
+		logger -t simmanager-fast-switch "Fast path is unsupported or unavailable (status ${fast_status}); using the unchanged vendor switch."
