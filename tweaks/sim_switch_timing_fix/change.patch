+sim_switch_pending() {
+	index=1
+	while [ "$index" -le "$cell_num" ]; do
+		[ "$index" = 1 ] && section="cellular" || section="cellular${index}"
+		desired=$(uci -q get "cellular.${section}.hw_sim")
+		case "$desired" in
+			sim1) sim_suffix="" ;;
+			sim[2-9]) sim_suffix=${desired#sim} ;;
+			*) index=$((index + 1)); continue ;;
+		esac
+		sim_fs=$(uci -q get "hw_info.${section}.s${sim_suffix}_fs")
+		sim_file=$(uci -q get "hw_info.${section}.s${sim_suffix}_file")
+		expected=$(uci -q get "hw_info.${section}.s${sim_suffix}_val")
+		[ -n "$sim_fs" ] && [ -n "$sim_file" ] && [ -n "$expected" ] || {
+			index=$((index + 1))
+			continue
+		}
+		current=$(cat "/sys/class/${sim_fs}/${sim_file}" 2>/dev/null)
+		[ -n "$current" ] && [ "$current" != "$expected" ] && return 0
+		index=$((index + 1))
+	done
+	return 1
+}
