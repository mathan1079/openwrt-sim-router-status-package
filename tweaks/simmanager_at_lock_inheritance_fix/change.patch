diff --git a/original/usr/sbin/simmanager-control b/changed/usr/sbin/simmanager-control
index 4febcb7..19d6a04 100755
--- a/original/usr/sbin/simmanager-control
+++ b/changed/usr/sbin/simmanager-control
@@ -22,8 +22,8 @@ activation_max_checks=${SIMMANAGER_ACTIVATION_MAX_CHECKS:-45}
 
 locked_at() {
 	(
-		flock -x 9
-		at-cmd "$@"
+		flock -w 3 -x 9 || exit 75
+		timeout 6 at-cmd "$@"
 	) 9>"$at_lock"
 }
 
@@ -178,6 +178,9 @@ wait_for_sim_ready() {
 	count=0
 	while [ "$count" -lt 30 ]; do
 		[ "$ignore_guard" = rollback ] || automation_allowed || return 1
+		# A routed 2-of-3 Internet proof is stronger evidence than a CPIN
+		# query and prevents a busy AT port from holding a completed switch.
+		activation_health_check && return 0
 		locked_at "$query_port" 'AT+CPIN?' 2>/dev/null | tr -d '\r' | grep -q '+CPIN: READY' && return 0
 		count=$((count + 1))
 		sleep 2
@@ -191,6 +194,7 @@ wait_for_registration() {
 	count=0
 	while [ "$count" -lt 45 ]; do
 		automation_allowed || return 1
+		activation_health_check && return 0
 		registration=$(locked_at "$query_port" 'AT+CEREG?' 2>/dev/null | tr -d '\r' | grep '+CEREG:' | tail -n 1)
 		registration_5g=$(locked_at "$query_port" 'AT+C5GREG?' 2>/dev/null | tr -d '\r' | grep '+C5GREG:' | tail -n 1)
 		case "$registration" in *,1|*,1,*|*,5|*,5,*) return 0 ;; esac
diff --git a/original/usr/sbin/simmanager-fast-switch b/changed/usr/sbin/simmanager-fast-switch
index bdf477a..41d571d 100755
--- a/original/usr/sbin/simmanager-fast-switch
+++ b/changed/usr/sbin/simmanager-fast-switch
@@ -58,6 +58,11 @@ at_reply() {
 hard_fallback() {
 	reason="$1"
 	logger -t simmanager-fast-switch "Fast switch could not be proved (${reason}); using the unchanged vendor hard power-cycle fallback."
+	# The vendor fallback starts a long-running modem worker.  Release and close
+	# the AT-lock descriptor first so that worker cannot inherit the lock and
+	# leave every later AT command blocked forever.
+	flock -u 9
+	exec 9>&-
 	cellular_sw "$target" "$count"
 	exit $?
 }
@@ -94,6 +99,10 @@ fast_switch_locked() {
 		if printf '%s\n' "$cpin" | grep -q '^+CPIN:[[:space:]]*READY$' && valid_iccid "$new_iccid"; then
 			if [ -z "$old_iccid" ] || [ "$new_iccid" != "$old_iccid" ]; then
 				logger -t simmanager-fast-switch "Fast GPIO switch selected ${target}; SIM ${new_iccid} became ready without restarting USB."
+				# watchsystem also starts a long-running modem worker.  Never let it
+				# inherit the AT-lock descriptor.
+				flock -u 9
+				exec 9>&-
 				watchsystem
 				return 0
 			fi
diff --git a/original/usr/sbin/simmanager-sms b/changed/usr/sbin/simmanager-sms
index 2b4fc32..c56038f 100644
--- a/original/usr/sbin/simmanager-sms
+++ b/changed/usr/sbin/simmanager-sms
@@ -1,4 +1,6 @@
 #!/bin/sh
 
 lock=${SIMMANAGER_AT_LOCK:-/tmp/simmanager-at.lock}
-exec flock -x "$lock" /usr/libexec/simmanager-sms "$@"
+# Auto-sync runs every ten seconds.  Skip one cycle instead of waiting forever
+# behind an activation or another modem owner; the daemon will retry normally.
+exec flock -w 5 -x "$lock" /usr/libexec/simmanager-sms "$@"
