#!/bin/sh

# Automatic dual-SIM failover controller for the package-owned policy.
# Disabled by default. All disruptive work is delegated to simmanager-control,
# which validates profiles, backs up cellular UCI, serializes operations and
# rolls back failed registration. No firmware or vendor script is modified.

status_file=${SIMMANAGER_AUTO_STATUS_FILE:-/tmp/simmanager-auto.json}
status_new=${SIMMANAGER_AUTO_STATUS_NEW:-/tmp/simmanager-auto.json.new}
disconnect_file=${SIMMANAGER_AUTO_DISCONNECT_FILE:-/tmp/simmanager-disconnects}
disconnect_new=${SIMMANAGER_AUTO_DISCONNECT_NEW:-/tmp/simmanager-disconnects.new}
state_root=${SIMMANAGER_AUTO_STATE_ROOT:-/etc/simmanager}
state_file=$state_root/auto-state
state_new=$state_root/auto-state.new
control=${SIMMANAGER_AUTO_CONTROL:-/usr/sbin/simmanager-control}
control_lock_dir=${SIMMANAGER_CONTROL_LOCK_DIR:-/tmp/simmanager-control.lock}
init_service=${SIMMANAGER_AUTO_INIT:-/etc/init.d/simmanager-auto}
probe_hosts=${SIMMANAGER_AUTO_PROBES:-"1.1.1.1 8.8.8.8 9.9.9.9"}
probe_hosts_v6=${SIMMANAGER_AUTO_PROBES_V6:-"2606:4700:4700::1111 2001:4860:4860::8888 2620:fe::fe"}
monitor_interval=5

write_status() {
	state="$1"
	message="$2"
	reason="${3:-}"
	active="${4:-$(uci -q get cellular.cellular.hw_sim)}"
	next="${5:-0}"
	. /usr/share/libubox/jshn.sh
	json_init
	json_add_string state "$state"
	json_add_string message "$message"
	json_add_string reason "$reason"
	json_add_string active_sim "${active:-unknown}"
	json_add_string default_sim "${default_sim:-unknown}"
	json_add_string next_retry "$next"
	json_add_string next_switch_attempt "${next_switch_attempt:-0}"
	json_add_string updated_at "$(date +%s)"
	json_dump > "$status_new" && mv -f "$status_new" "$status_file"
	json_cleanup
	logger -t simmanager-auto "$state: $message"
}

number_value() {
	value="$1"
	fallback="$2"
	case "$value" in ''|*[!0-9]*) printf '%s\n' "$fallback" ;; *) printf '%s\n' "$value" ;; esac
}

load_config() {
	default_sim=$(uci -q get simmanager.automation.default_sim)
	[ "$default_sim" = sim1 ] || [ "$default_sim" = sim2 ] || default_sim=sim1
	failure_seconds=$(number_value "$(uci -q get simmanager.automation.failure_seconds)" 20)
	recover_before_failover=$(uci -q get simmanager.automation.recover_before_failover)
	[ "$recover_before_failover" = "1" ] || recover_before_failover=0
	disconnect_limit=$(number_value "$(uci -q get simmanager.automation.disconnect_limit)" 3)
	disconnect_window_minutes=$(number_value "$(uci -q get simmanager.automation.disconnect_window_minutes)" 10)
	cooldown_minutes=$(number_value "$(uci -q get simmanager.automation.cooldown_minutes)" 30)
	max_switches_per_day=$(number_value "$(uci -q get simmanager.automation.max_switches_per_day)" 4)
}

state_value() {
	[ -f "$state_file" ] || return 0
	sed -n "s/^$1=//p" "$state_file" | tail -n 1
}

load_state() {
	mode=$(state_value mode); mode=${mode:-primary}
	retry_index=$(number_value "$(state_value retry_index)" 0)
	next_retry=$(number_value "$(state_value next_retry)" 0)
	last_switch=$(number_value "$(state_value last_switch)" 0)
	switch_day=$(state_value switch_day); switch_day=${switch_day:-$(date +%Y%m%d)}
	switch_count=$(number_value "$(state_value switch_count)" 0)
	secondary_since=$(number_value "$(state_value secondary_since)" 0)
	failed_attempts=$(number_value "$(state_value failed_attempts)" 0)
	next_switch_attempt=$(number_value "$(state_value next_switch_attempt)" 0)
}

save_state() {
	mkdir -p "$state_root" || return 1
	{
		printf 'mode=%s\n' "$mode"
		printf 'retry_index=%s\n' "$retry_index"
		printf 'next_retry=%s\n' "$next_retry"
		printf 'last_switch=%s\n' "$last_switch"
		printf 'switch_day=%s\n' "$switch_day"
		printf 'switch_count=%s\n' "$switch_count"
		printf 'secondary_since=%s\n' "$secondary_since"
		printf 'failed_attempts=%s\n' "$failed_attempts"
		printf 'next_switch_attempt=%s\n' "$next_switch_attempt"
	} > "$state_new" && mv -f "$state_new" "$state_file"
}

disable_for_vendor_conflict() {
	write_status blocked "Disabled because the vendor Automatic SIM card switching controller is enabled." vendor_conflict "$(uci -q get cellular.cellular.hw_sim)" 0
	uci set simmanager.automation.enabled=0
	uci commit simmanager
	"$init_service" disable >/dev/null 2>&1
}

guard_enabled() {
	[ "$(uci -q get simmanager.automation.enabled)" = "1" ] || return 1
	if [ "$(uci -q get cellular.cellular.hw_asw)" = "1" ]; then
		disable_for_vendor_conflict
		return 1
	fi
	return 0
}

network_device() {
	json=$(ubus call network.interface.cellular status 2>/dev/null) || return 1
	up=$(jsonfilter -s "$json" -e '@.up' 2>/dev/null)
	[ "$up" = true ] || return 1
	device=$(jsonfilter -s "$json" -e '@.l3_device' 2>/dev/null)
	[ -n "$device" ] || device=$(jsonfilter -s "$json" -e '@.device' 2>/dev/null)
	[ -n "$device" ] || device=$(uci -q get cellular.cellular._ifname)
	[ -n "$device" ] || return 1
	printf '%s\n' "$device"
}

health_check() {
	device=$(network_device) || return 1
	active_profile=$(uci -q get cellular.cellular.hw_sim)
	probe_pdp=$(uci -q get "simmanager.${active_profile}.pdp_type")
	[ -n "$probe_pdp" ] || probe_pdp=$(uci -q get cellular.cellular.m_pdp)
	probe_command=ping
	health_hosts="$probe_hosts"
	if [ "$probe_pdp" = IPV6 ]; then
		command -v ping6 >/dev/null 2>&1 || return 1
		probe_command=ping6
		health_hosts="$probe_hosts_v6"
	fi
	success=0
	pids=""
	for host in $health_hosts; do
		"$probe_command" -I "$device" -c 1 -W 2 "$host" >/dev/null 2>&1 &
		pids="$pids $!"
	done
	for pid in $pids; do
		wait "$pid" && success=$((success + 1))
	done
	[ "$success" -ge 2 ]
}

verify_stable_health() {
	checks=0
	consecutive=0
	while [ "$checks" -lt 6 ]; do
		guard_enabled || return 2
		if health_check; then
			consecutive=$((consecutive + 1))
			[ "$consecutive" -ge 3 ] && return 0
		else
			consecutive=0
		fi
		checks=$((checks + 1))
		[ "$checks" -lt 6 ] && sleep "$monitor_interval"
	done
	return 1
}

record_disconnect() {
	now="$1"
	window_seconds=$((disconnect_window_minutes * 60))
	cutoff=$((now - window_seconds))
	{ [ -f "$disconnect_file" ] && cat "$disconnect_file"; printf '%s\n' "$now"; } |
		awk -v cutoff="$cutoff" '$1 >= cutoff && $1 ~ /^[0-9]+$/' > "$disconnect_new"
	mv -f "$disconnect_new" "$disconnect_file"
}

disconnect_count() {
	now="$1"
	window_seconds=$((disconnect_window_minutes * 60))
	cutoff=$((now - window_seconds))
	if [ -f "$disconnect_file" ]; then
		awk -v cutoff="$cutoff" '$1 >= cutoff && $1 ~ /^[0-9]+$/ { count++ } END { print count + 0 }' "$disconnect_file"
	else
		printf '0\n'
	fi
}

reset_disconnects() {
	rm -f "$disconnect_file" "$disconnect_new"
}

refresh_daily_budget() {
	today=$(date +%Y%m%d)
	if [ "$switch_day" != "$today" ]; then
		switch_day="$today"
		switch_count=0
		save_state
	fi
}

can_switch_now() {
	now="$1"
	emergency="${2:-0}"
	refresh_daily_budget
	if [ "$next_switch_attempt" -gt "$now" ]; then
		write_status backoff "A failed automatic switch is in safety backoff before another disruptive attempt." switch_backoff "$(uci -q get cellular.cellular.hw_sim)" "$next_retry"
		return 4
	fi
	if [ "$next_switch_attempt" -gt 0 ]; then
		next_switch_attempt=0
		save_state
	fi
	[ "$switch_count" -lt "$max_switches_per_day" ] || {
		write_status limited "Daily automatic switch limit reached; waiting for manual review or the next day." daily_limit "$(uci -q get cellular.cellular.hw_sim)" "$next_retry"
		return 1
	}
	if [ "$emergency" != "1" ]; then
		cooldown_seconds=$((cooldown_minutes * 60))
		[ "$last_switch" -eq 0 ] || [ $((now - last_switch)) -ge "$cooldown_seconds" ] || {
			write_status cooldown "A scheduled SIM change is waiting for the minimum switch cooldown." cooldown "$(uci -q get cellular.cellular.hw_sim)" "$next_retry"
			return 4
		}
	fi
	return 0
}

record_switch_attempt() {
	now="$1"
	refresh_daily_budget
	last_switch="$now"
	switch_count=$((switch_count + 1))
	save_state
}

clear_failed_attempts() {
	failed_attempts=0
	next_switch_attempt=0
	save_state
}

record_failed_attempt() {
	now="$1"
	failed_attempts=$((failed_attempts + 1))
	case "$failed_attempts" in
		1) retry_delay=30 ;;
		2) retry_delay=60 ;;
		3) retry_delay=120 ;;
		*) retry_delay=300 ;;
	esac
	next_switch_attempt=$((now + retry_delay))
	save_state
}

recover_active() {
	active="$1"
	reason="$2"
	guard_enabled || return 2
	write_status recovering "Reapplying the active SIM profile once before failover." "$reason" "$active" "$next_retry"
	"$control" activate "$active" automatic
	recovery_status=$?
	if [ "$recovery_status" -eq 3 ]; then
		disable_after_rollback_failure
		return 2
	fi
	if [ "$recovery_status" -eq 0 ] && verify_stable_health; then
		write_status healthy "The active SIM recovered and passed three consecutive connectivity checks." recovered "$active" "$next_retry"
		return 0
	fi
	return 1
}

disable_after_rollback_failure() {
	uci set simmanager.automation.enabled=0
	uci commit simmanager
	"$init_service" disable >/dev/null 2>&1
	write_status critical "Rollback could not restore verified connectivity. Automatic switching was disabled for manual recovery." rollback_failed "$(uci -q get cellular.cellular.hw_sim)" 0
}

switch_and_verify() {
	target="$1"
	reason="$2"
	guard_enabled || return 2
	now=$(date +%s)
	emergency=0
	case "$reason" in sustained_outage|reconnect_loop|secondary_failed) emergency=1 ;; esac
	can_switch_now "$now" "$emergency"
	switch_permission=$?
	[ "$switch_permission" -eq 0 ] || return "$switch_permission"
	from=$(uci -q get cellular.cellular.hw_sim)
	[ "$from" = sim1 ] || [ "$from" = sim2 ] || {
		write_status error "Current physical SIM is unknown; automatic switching was cancelled." unknown_active "$from" "$next_retry"
		return 1
	}
	[ "$from" != "$target" ] || return 0
	if [ -d "$control_lock_dir" ]; then
		write_status waiting "A manual SIM operation is finishing; emergency failover will retry on the next health check." manual_operation "$from" "$next_retry"
		return 4
	fi
	write_status switching "Switching through the guarded backup-and-rollback controller." "$reason" "$from" "$next_retry"
	record_switch_attempt "$now"
	"$control" activate "$target" automatic
	control_status=$?
	if [ "$control_status" -ne 0 ]; then
		if [ "$control_status" -eq 3 ]; then
			disable_after_rollback_failure
			return 2
		fi
		record_failed_attempt "$(date +%s)"
		write_status failed "The target SIM did not activate; the guarded controller attempted rollback." activation_failed "$(uci -q get cellular.cellular.hw_sim)" "$next_retry"
		return 1
	fi
	write_status verifying "The target SIM registered; proving Internet connectivity before accepting it." "$reason" "$target" "$next_retry"
	if verify_stable_health; then
		clear_failed_attempts
		write_status healthy "The target SIM passed three consecutive interface-bound connectivity checks." switched "$target" "$next_retry"
		return 0
	fi
	write_status rolling_back "The target SIM registered but failed Internet verification; restoring the previous SIM." connectivity_failed "$target" "$next_retry"
	if "$control" rollback automatic && verify_stable_health; then
		record_failed_attempt "$(date +%s)"
		write_status rollback_complete "The previous working SIM and cellular configuration were restored." rollback_complete "$(uci -q get cellular.cellular.hw_sim)" "$next_retry"
		return 1
	fi
	disable_after_rollback_failure
	return 2
}

set_secondary_schedule() {
	now=$(date +%s)
	mode=secondary
	retry_index=0
	secondary_since="$now"
	next_retry=$((now + 21600))
	save_state
}

schedule_next_primary_retry() {
	now=$(date +%s)
	[ "$secondary_since" -gt 0 ] || secondary_since="$now"
	retry_index=$((retry_index + 1))
	while :; do
		case "$retry_index" in
			1) retry_offset=43200 ;;
			2) retry_offset=64800 ;;
			3) retry_offset=86400 ;;
			*) retry_offset=$(((retry_index - 2) * 86400)) ;;
		esac
		candidate_retry=$((secondary_since + retry_offset))
		[ "$candidate_retry" -gt "$now" ] && break
		retry_index=$((retry_index + 1))
	done
	mode=secondary
	next_retry="$candidate_retry"
	save_state
}

set_primary_state() {
	mode=primary
	retry_index=0
	next_retry=0
	secondary_since=0
	failed_attempts=0
	next_switch_attempt=0
	save_state
}

manual_activation() {
	target="$1"
	[ "$target" = sim1 ] || [ "$target" = sim2 ] || return 2
	load_config
	load_state
	last_switch=0
	failed_attempts=0
	next_switch_attempt=0
	if [ "$target" = "$default_sim" ]; then
		set_primary_state
	else
		set_secondary_schedule
	fi
	reset_disconnects
}

other_sim() {
	[ "$1" = sim1 ] && printf 'sim2\n' || printf 'sim1\n'
}

stop_handler() {
	load_config
	write_status stopped "Automatic switching service stopped." stopped "$(uci -q get cellular.cellular.hw_sim)" 0
	exit 0
}

run_monitor() {
	trap stop_handler HUP INT TERM
	load_config
	load_state
	guard_enabled || exit 0
	write_status monitoring "Monitoring the selected default SIM and reconnect stability." started "$(uci -q get cellular.cellular.hw_sim)" "$next_retry"
	last_health=unknown
	failure_since=0

	while :; do
		load_config
		load_state
		guard_enabled || exit 0
		now=$(date +%s)
		active=$(uci -q get cellular.cellular.hw_sim)
		[ "$active" = sim1 ] || [ "$active" = sim2 ] || {
			write_status error "Current physical SIM is unknown; monitoring without switching." unknown_active "$active" "$next_retry"
			sleep "$monitor_interval"
			continue
		}

		if [ "$active" != "$default_sim" ] && [ "$next_retry" -eq 0 ]; then
			set_secondary_schedule
		fi

		if health_check; then
			last_health=up
			failure_since=0
			# A proved healthy current path ends the failed-attempt streak. Keep the
			# daily disruptive-attempt count, but do not make a later independent
			# outage inherit increasingly long retry backoff.
			if [ "$failed_attempts" -gt 0 ] || [ "$next_switch_attempt" -gt 0 ]; then
				clear_failed_attempts
			fi
			if [ "$active" = "$default_sim" ]; then
				[ "$mode" = primary ] && [ "$next_retry" -eq 0 ] || set_primary_state
				write_status healthy "Default SIM is online; connectivity proof passed." online "$active" 0
			elif [ "$now" -ge "$next_retry" ]; then
				write_status failback_due "Testing the configured default SIM according to the 6/12/18/24-hour schedule." scheduled_retry "$active" "$next_retry"
				switch_and_verify "$default_sim" scheduled_primary_retry
				scheduled_result=$?
				if [ "$scheduled_result" -eq 0 ]; then
					set_primary_state
					reset_disconnects
				elif [ "$scheduled_result" -ne 4 ] && [ "$(uci -q get simmanager.automation.enabled)" = "1" ]; then
					schedule_next_primary_retry
				fi
			else
				write_status secondary "Secondary SIM is online; waiting for the next scheduled default-SIM test." failover_active "$active" "$next_retry"
			fi
		else
			if [ "$last_health" != down ]; then
				record_disconnect "$now"
				last_health=down
			fi
			[ "$failure_since" -gt 0 ] || failure_since="$now"
			elapsed=$((now - failure_since))
			events=$(disconnect_count "$now")
			reason="sustained_outage"
			trigger=0
			[ "$elapsed" -ge "$failure_seconds" ] && trigger=1
			if [ "$events" -ge "$disconnect_limit" ]; then
				trigger=1
				reason=reconnect_loop
			fi

			if [ "$trigger" -eq 1 ]; then
				if [ "$active" = "$default_sim" ]; then
					recovery_result=1
					if [ "$recover_before_failover" = "1" ]; then
						recover_active "$active" "$reason"
						recovery_result=$?
					fi
					if [ "$recover_before_failover" = "1" ] && [ "$recovery_result" -eq 0 ]; then
						reset_disconnects
						failure_since=0
						last_health=up
					elif [ "$recovery_result" -ne 2 ]; then
						standby=$(other_sim "$default_sim")
						if switch_and_verify "$standby" "$reason"; then
							set_secondary_schedule
							reset_disconnects
							failure_since=0
							last_health=up
						fi
					fi
				else
					if switch_and_verify "$default_sim" secondary_failed; then
						set_primary_state
						reset_disconnects
						failure_since=0
						last_health=up
					fi
				fi
			else
				write_status degraded "Connectivity checks are failing, but the confirmation threshold has not been reached." checking "$active" "$next_retry"
			fi
		fi
		sleep "$monitor_interval"
	done
}

show_status() {
	if [ -f "$status_file" ]; then cat "$status_file"; else printf '{"state":"stopped","message":"Automatic switching has not started."}\n'; fi
}

[ "${SIMMANAGER_AUTO_LIBRARY_ONLY:-0}" = "1" ] && return 0

case "${1:-status}" in
	run) run_monitor ;;
	status) show_status ;;
	vendor-conflict) load_config; disable_for_vendor_conflict ;;
	manual-activation) manual_activation "${2:-}" ;;
	*) printf 'Usage: %s {run|status|vendor-conflict|manual-activation sim1|sim2}\n' "$0" >&2; exit 2 ;;
esac
